    /// <summary>A top-level row with its sub-tasks, in a group or not.</summary>
    private RenderFragment RowView(TimelineRow row, TimelineScale scale, EpicColor? epicColor, bool inGroup = false) => __builder =>
    {
        var expanded = _expanded.Contains(row.Task.Key);
        var task = Shown(row.Task);
        <div class="tl-row @(inGroup ? "tl-child" : "") @(TaskKey == row.Task.Key ? "is-open" : "")" data-testid="tl-row" data-key="@row.Task.Key" @key="row.Task.Key">
            <div class="tl-label">
                @Cells(row.Task, row.ScheduledSubtasks.Count + row.UnscheduledSubtasks.Count > 0
                    ? @<button type="button" class="tl-expand icon-btn" aria-expanded="@(expanded ? "true" : "false")"
                               aria-label="@($"{(expanded ? "Hide" : "Show")} sub-tasks of {row.Task.Key}")"
                               @onclick="() => ToggleExpanded(row.Task.Key)"><Icon Name="@(expanded ? "chevron-down" : "chevron-right")" Size="14" /></button>
                    : @<span class="tl-expand-space" aria-hidden="true"></span>)
            </div>
            <div class="tl-track">
                @if (task.IsScheduled)
                {
                    <TimelineBar Item="task" Scale="scale" CanContribute="_view!.CanContribute" IsPending="@(_pending?.Key == task.Key)"
                                 ColorByEpic="_colorByEpic" EpicColor="epicColor" OnKeyDown="e => BarKeyDownAsync(row.Task, e)" OnActivate="() => ActivateAsync(row.Task)" />
                }
                else if (_view!.CanContribute)
                {
                    <button type="button" class="tl-schedule" aria-label="Schedule @row.Task.Key" @onclick="() => ScheduleAsync(row.Task)">Schedule</button>
                }
            </div>
        </div>
        @if (expanded)
        {
            @foreach (var subtask in row.ScheduledSubtasks)
            {
                <div class="tl-row tl-subrow @(inGroup ? "tl-child" : "")" data-testid="tl-subrow" data-key="@subtask.Key" @key="subtask.Key">
                    <div class="tl-label">
                        @Cells(subtask, null, null, actions: false)
                    </div>
                    <div class="tl-track">
                        <TimelineBar Item="Shown(subtask)" Scale="scale" CanContribute="_view!.CanContribute" IsPending="@(_pending?.Key == subtask.Key)"
                                     ColorByEpic="_colorByEpic" EpicColor="epicColor" OnKeyDown="e => BarKeyDownAsync(subtask, e)" OnActivate="() => ActivateAsync(subtask)" />
                    </div>
                </div>
            }
            @if (row.UnscheduledSubtasks.Count > 0)
            {
                <div class="tl-row tl-subrow" data-testid="tl-unscheduled-subtasks" @key="@($"{row.Task.Key}-unscheduled")">
                    <div class="tl-label tl-label-full">
                        <span class="hint">Not scheduled:</span>
                        @foreach (var subtask in row.UnscheduledSubtasks)
                        {
                            <a class="task-link" href="@TaskHref(subtask.Key)"><span class="key">@subtask.Key</span> @subtask.Title</a>
                        }
                    </div>
                    <div class="tl-track"></div>
                </div>
            }
        }
    };

    /// <summary>A row's Actions (Phase 3 FR-047): open it, schedule it when it has no dates, or add a dependency. Viewers
    /// only open it. A button that shows a group of buttons, like the backlog's Move, so Tab reaches each one and Escape
    /// closes it.</summary>
    private RenderFragment Actions(TimelineItem item) => __builder =>
    {
        var open = _menuFor == item.Key;
        <span class="tl-actions">
            <button type="button" id="tl-actions-@item.Key" class="icon-btn tl-actions-btn" aria-expanded="@(open ? "true" : "false")"
                    aria-controls="@(open ? $"tl-actions-{item.Key}-menu" : null)" aria-label="Actions for @item.Key"
                    @onclick="() => _menuFor = open ? null : item.Key" @onkeydown="e => ActionsKeyDown(item, e)">⋯</button>
            @if (open)
            {
                <div class="menu-backdrop" @onclick="() => _menuFor = null"></div>
                <div id="tl-actions-@item.Key-menu" class="user-menu tl-menu" role="group" aria-label="Actions for @item.Key"
                     @onkeydown="e => ActionsKeyDown(item, e)">
