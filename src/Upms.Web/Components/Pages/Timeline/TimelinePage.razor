@page "/spaces/{Key}/timeline"
@using System.Globalization
@using Upms.Application.Work
@using Upms.Domain.Common
@using Upms.Domain.Work
@using Upms.Web.Components.Pages.Drawer
@implements IDisposable
@inject ITimelineService Timelines
@inject IWorkItemService Items
@inject ViewerToday ViewerToday
@inject LiveAnnouncer Announcer
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject CreateWorkLauncher Launcher
@inject IOrganizationAdminService Organization

<PageTitle>@(_view?.ProjectName ?? Key) · Timeline · U-PMS</PageTitle>

@* The Timeline view (Phase 2 FR-034–FR-040, research R12): bars positioned from their dates, a today line, the
   unscheduled tasks beside the track, and rescheduling by dragging (timeline.js) or with the keyboard. *@
@if (_notFound)
{
    <NotFoundContent />
}
else if (_view is null)
{
    <p aria-busy="true">Loading the timeline…</p>
}
else
{
    var scale = TimelineScale.For(_zoom, ScheduledDates(), _today);
    <ProjectHeader ProjectKey="@_view.ProjectKey" Title="@_view.ProjectName" Current="ProjectPage.Timeline" Template="_view.Template"
                   CanManage="_view.CanManage" CanRestoreDeleted="_view.CanRestoreDeleted" />

    @* Jira's timeline toolbar: search, the people, "Filter"; view settings and refresh on the right. *@
    <div class="tl-toolbar">
        <div class="board-search">
            <Icon Name="search" />
            <input type="search" class="input" aria-label="Search the timeline" placeholder="Search timeline" @bind="_search" @bind:event="oninput" />
        </div>
        <div class="avatar-filter" role="group" aria-label="Filter by assignee">
            <button type="button" class="avatar-toggle @(_people.Contains(NoOne) ? "is-on" : "")" aria-pressed="@(_people.Contains(NoOne) ? "true" : "false")"
                    title="Unassigned" @onclick="() => TogglePerson(NoOne)">
                <span class="avatar avatar-unassigned" aria-hidden="true"><Icon Name="person" Size="14" /></span>
                <span class="sr-only">Unassigned</span>
            </button>
            @foreach (var person in People.Take(8))
            {
                var id = person.UserId.ToString();
                var on = _people.Contains(id);
                <button type="button" class="avatar-toggle @(on ? "is-on" : "")" aria-pressed="@(on ? "true" : "false")" title="@person.DisplayName"
                        @onclick="() => TogglePerson(id)">
                    <Avatar UserId="person.UserId" Initials="@person.Initials" />
                    <span class="sr-only">@person.DisplayName</span>
                </button>
            }
        </div>
        <div class="toolbar-pop">
            <button type="button" class="btn btn-sm toolbar-btn @(FilterCount > 0 ? "is-on" : "")" aria-expanded="@(_filterOpen ? "true" : "false")"
                    aria-controls="tl-filter-panel" @onclick="() => { _filterOpen = !_filterOpen; _settingsOpen = false; }">
                <Icon Name="filter" /> Filter@(FilterCount > 0 ? $" ({FilterCount})" : "")
            </button>
            @if (_filterOpen)
            {
                <div class="menu-backdrop" @onclick="() => _filterOpen = false"></div>
                <div id="tl-filter-panel" class="toolbar-panel" role="group" aria-label="Filter the timeline"
                     @onkeydown="@(e => { if (e.Key == "Escape") { _filterOpen = false; } })">
                    <p class="panel-heading">Status type</p>
                    <div class="quick-filters">
                        @foreach (var category in Enum.GetValues<StatusCategory>())
                        {
                            var pressed = _categories.Contains(category);
                            <button type="button" class="btn btn-sm quick @(pressed ? "active" : "")" aria-pressed="@(pressed ? "true" : "false")"
                                    @onclick="() => Flip(_categories, category)">@TimelineBar.StatusLabel(category)</button>
                        }
                    </div>
                    <p class="panel-heading">Work type</p>
                    <div class="quick-filters">
                        @foreach (var kind in KindsShown)
                        {
                            var pressed = _kinds.Contains(kind);
                            <button type="button" class="btn btn-sm quick @(pressed ? "active" : "")" aria-pressed="@(pressed ? "true" : "false")"
                                    @onclick="() => Flip(_kinds, kind)"><TypeIcon Type="kind" /> @WorkItemTypes.DisplayName(kind)</button>
                        }
                    </div>
                    @if (FilterCount > 0)
                    {
                        <button type="button" class="btn btn-sm btn-ghost panel-clear" @onclick="ClearFilters">Clear filters</button>
                    }
                </div>
            }
        </div>
        @if (FilterCount > 0 || _people.Count > 0)
        {
            <button type="button" class="btn btn-sm btn-ghost" @onclick="ClearFilters">Clear filters</button>
        }
        <span class="spacer"></span>
        @* Jira's "Export": the chart as it is shown (scale, colours, filters) as an image or a PDF, or its rows as a spreadsheet. *@
        @if (_canExport)
        {
        <div class="tab-menu">
            <button type="button" id="tl-export-button" class="btn btn-sm toolbar-btn" data-testid="timeline-export" aria-haspopup="menu"
                    aria-expanded="@(_exportOpen ? "true" : "false")" aria-controls="@(_exportOpen ? "tl-export" : null)"
                    @onclick="() => { _exportOpen = !_exportOpen; _settingsOpen = false; _filterOpen = false; }"><Icon Name="download" /> Export</button>
            @if (_exportOpen)
            {
                <div class="menu-backdrop" @onclick="() => _exportOpen = false"></div>
                <ul id="tl-export" class="column-menu-list tl-export-menu" role="menu" aria-label="Export the timeline"
                    @onkeydown="@(e => { if (e.Key == "Escape") { _exportOpen = false; _focusAfterRender = "tl-export-button"; } })">
                    <li role="none"><button type="button" role="menuitem" class="column-menu-item" @onclick="DownloadPngAsync">Image (PNG)</button></li>
                    <li role="none"><a role="menuitem" class="column-menu-item" href="@ExportUrl("svg")" download @onclick="() => _exportOpen = false">Image (SVG)</a></li>
                    <li role="none"><a role="menuitem" class="column-menu-item" href="@ExportUrl("print")" target="_blank" rel="noopener" @onclick="() => _exportOpen = false">PDF (print)</a></li>
                    <li role="none"><a role="menuitem" class="column-menu-item" href="@ExportUrl("csv")" download @onclick="() => _exportOpen = false">Excel (CSV)</a></li>
                </ul>
            }
        </div>
        }
        <div class="tab-menu">
            <button type="button" id="tl-settings-button" class="icon-btn tl-tool" aria-label="View settings" title="View settings"
                    aria-expanded="@(_settingsOpen ? "true" : "false")" aria-controls="@(_settingsOpen ? "tl-settings" : null)"
                    @onclick="() => { _settingsOpen = !_settingsOpen; _filterOpen = false; }"><Icon Name="sliders" /></button>
            @if (_settingsOpen)
            {
                <div class="menu-backdrop" @onclick="() => _settingsOpen = false"></div>
                <div id="tl-settings" class="tab-popover tl-settings" role="region" aria-label="View settings"
                     @onkeydown="@(e => { if (e.Key == "Escape") { _settingsOpen = false; _focusAfterRender = "tl-settings-button"; } })">
                    <h2 class="popover-title">View settings</h2>
                    <label class="tl-setting">
                        <input type="checkbox" data-testid="hide-completed" checked="@_view.HidingCompleted" @onchange="ToggleCompleted" />
                        Hide completed work items
                    </label>
                    <p class="popover-title">Visual details</p>
                    <label class="tl-setting">
                        <input type="checkbox" checked="@_showDependencies" @onchange="() => SetOptionAsync(DependenciesKey, _showDependencies = !_showDependencies)" />
                        Dependencies
                    </label>
                    <label class="tl-setting">
                        <input type="checkbox" checked="@_showProgress" @onchange="() => SetOptionAsync(ProgressKey, _showProgress = !_showProgress)" />
                        Progress
                    </label>
                    <p class="popover-title">Bar colours</p>
                    <label class="tl-setting">
                        <input type="radio" name="tl-colors" checked="@(!_colorByEpic)" @onchange="() => SetOptionAsync(ColorsKey, _colorByEpic = false)" />
                        Status type
                    </label>
                    <label class="tl-setting">
                        <input type="radio" name="tl-colors" checked="@_colorByEpic" @onchange="() => SetOptionAsync(ColorsKey, _colorByEpic = true)" />
                        @(_view.Template == ProjectTemplate.StageGate ? "Stage" : "Epic") colour
                    </label>
                </div>
            }
        </div>
        <button type="button" class="icon-btn tl-tool" aria-label="Refresh" title="Refresh" @onclick="LoadAsync"><Icon Name="refresh" /></button>
    </div>

    @if (_conflict is not null)
    {
        <div class="alert alert-warn" role="alert" data-testid="conflict">
            @_conflict
            <button type="button" class="btn btn-sm btn-ghost" @onclick="() => _conflict = null">Dismiss</button>
        </div>
    }
    @if (_error is not null)
    {
        <div class="alert alert-error" role="alert">
            @_error
            <button type="button" class="btn btn-sm btn-ghost" @onclick="() => _error = null">Dismiss</button>
        </div>
    }
    @if (_view.ScheduledCount > _view.Rows.Count)
    {
        <p class="hint">Showing the latest @_view.Rows.Count of @_view.ScheduledCount scheduled tasks.</p>
    }

    <p id="tl-help" class="sr-only">
        @(_view.CanContribute
            ? "Left and Right arrows move the task by a day; with Shift they change only the due date, with Ctrl only the start date. Enter saves, Escape cancels, and Enter with no change opens the task."
            : "Enter opens the task.")
    </p>

    <div class="tl-layout">
        <div class="tl-scroll" @ref="_scroller" data-ppd="@scale.PixelsPerDay.ToString(CultureInfo.InvariantCulture)" role="region" aria-label="Timeline">
            @if (_view.Rows.Count == 0 && _view.Groups.Count == 0 && _unscheduled.Count == 0)
            {
                <EmptyState Title="No work items yet." Text="Create a work item, then give it dates to see it on the timeline." />
            }
            else
            {
                <div class="tl-table @(scale.HasDayRow ? "has-days" : "")" style="--tl-track-width:@Px(scale.Width)">
                    @* The chart's background: a line between periods, the current one shaded, and today's line. *@
                    <div class="tl-grid" aria-hidden="true">
                        @foreach (var period in scale.Periods)
                        {
                            <span class="tl-period @(period.IsCurrent ? "is-current" : "")" style="left:@Px(period.Left);width:@Px(period.Width)"></span>
                        }
                        <span class="tl-today" style="left:@Px(scale.TodayLeft)"></span>
                    </div>
                    <div class="tl-head">
                        <div class="tl-label tl-corner"><span class="tl-work">Work</span><span class="tl-col-status">Status</span><span class="tl-col-assignee">Assignee</span></div>
                        <div class="tl-track tl-headings" aria-hidden="true">
                            <div class="tl-head-row">
                                @foreach (var period in scale.Periods)
                                {
                                    <span class="tl-heading @(period.IsCurrent ? "is-current" : "")" style="left:@Px(period.Left);width:@Px(period.Width)">@period.Label</span>
                                }
                            </div>
                            @if (scale.HasDayRow)
                            {
                                <div class="tl-day-row">
                                    @foreach (var day in scale.Days)
                                    {
                                        <span class="tl-day @(day.IsToday ? "is-today" : "") @(day.IsWeekend ? "is-weekend" : "")"
                                              style="left:@Px(day.Left);width:@Px(scale.PixelsPerDay)"><span>@day.Number</span></span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    @if (_view.Sprints.Count > 0)
                    {
                        <div class="tl-row tl-sprint-lane" data-testid="sprint-lane">
                            <div class="tl-label tl-label-full">Sprints</div>
                            <div class="tl-track">
                                @foreach (var sprint in _view.Sprints)
                                {
                                    <span class="tl-sprint tl-sprint-@sprint.State.ToString().ToLowerInvariant()" data-testid="sprint-bar"
                                          style="left:@Px(scale.Left(sprint.StartDate));width:@Px(scale.WidthOf(sprint.StartDate, sprint.EndDate))">@sprint.Name · @SprintStateText(sprint.State)<span class="sr-only">, @TimelineBar.DatesText(sprint.StartDate, sprint.EndDate)</span></span>
                                }
                            </div>
                        </div>
                    }
                    @foreach (var group in ShownGroups)
                    {
                        var open = !_collapsedGroups.Contains(group.Container.Key) || Filtering;
                        var container = Shown(group.Container);
                        var hasChildren = group.Rows.Count + group.Unscheduled.Count > 0;
                        <div class="tl-group" data-testid="tl-group" data-key="@group.Container.Key" @key="group.Container.Key">
                            <div class="tl-row tl-group-row @(TaskKey == group.Container.Key ? "is-open" : "")">
                                <div class="tl-label">
                                    @Cells(group.Container, hasChildren
                                        ? @<button type="button" class="tl-expand icon-btn" aria-expanded="@(open ? "true" : "false")"
                                                   aria-label="@($"{(open ? "Hide" : "Show")} the items of {group.Container.Key}")"
                                                   @onclick="() => ToggleGroup(group.Container.Key)"><Icon Name="@(open ? "chevron-down" : "chevron-right")" Size="14" /></button>
                                        : @<span class="tl-expand-space" aria-hidden="true"></span>,
                                        progress: hasChildren ? group.Progress : null)
                                    <span class="sr-only" data-testid="tl-progress">@group.Progress.Percent% done</span>
                                </div>
                                <div class="tl-track">
                                    @if (container.IsScheduled)
                                    {
                                        <TimelineBar Item="container" Scale="scale" CanContribute="_view.CanContribute" IsPending="@(_pending?.Key == container.Key)" Progress="group.Progress"
                                                     ColorByEpic="_colorByEpic" OnKeyDown="e => BarKeyDownAsync(group.Container, e)" OnActivate="() => ActivateAsync(group.Container)" />
                                    }
                                    else if (_view.CanContribute)
                                    {
                                        <button type="button" class="tl-schedule" aria-label="Schedule @group.Container.Key" @onclick="() => ScheduleAsync(group.Container)">Schedule</button>
                                    }
                                    @if (group.Gate is { } gate)
                                    {
                                        <span class="tl-gate" data-testid="gate-marker" style="left:@Px(scale.Left(gate.Date))"><span aria-hidden="true">◇</span> @GateText(gate.State)</span>
                                    }
                                </div>
                            </div>
                            @if (open)
                            {
                                @foreach (var row in group.Rows.Where(Matches))
                                {
                                    @RowView(row, scale, group.Container.Color, inGroup: true)
                                }
                                @foreach (var item in group.Unscheduled.Where(Matches))
                                {
                                    @UnscheduledRow(item, "tl-subrow", "tl-group-unscheduled")
                                }
                            }
                        </div>
                    }
                    @foreach (var row in _view.Rows.Where(Matches))
                    {
                        @RowView(row, scale, null)
                    }
                    @foreach (var item in _unscheduled.Where(Matches))
                    {
                        @UnscheduledRow(item, "", "unscheduled-item")
                    }
                    @if (_unscheduled.Count < _view.Unscheduled.TotalCount)
                    {
                        <div class="tl-row">
                            <div class="tl-label tl-label-full">
                                <button type="button" class="btn btn-sm btn-ghost show-more" @onclick="ShowMoreUnscheduledAsync">
                                    Show more (@(_view.Unscheduled.TotalCount - _unscheduled.Count) more without dates)
                                </button>
                            </div>
                            <div class="tl-track"></div>
                        </div>
                    }
                    <div class="tl-row tl-create-row">
                        <div class="tl-label tl-label-full">
                            @if (_view.CanContribute)
                            {
                                <button type="button" class="tl-create" @onclick="() => Launcher.Open(_view.ProjectKey)"><Icon Name="plus" Size="14" /> Create</button>
                            }
                            <span class="tl-count" role="status">@ShownCount of @TotalCount</span>
                        </div>
                        <div class="tl-track"></div>
                    </div>
                    <div class="tl-fill" aria-hidden="true"><div class="tl-label"></div><div class="tl-track"></div></div>
                    <svg class="tl-arrows" aria-hidden="true" focusable="false"></svg>
                </div>
            }
        </div>

        <div class="tl-zoom" role="group" aria-label="Scale">
            <button type="button" class="tl-zoom-btn" data-testid="go-today" @onclick="GoToTodayAsync">Today</button>
            <span class="tl-zoom-sep" aria-hidden="true"></span>
            @foreach (var zoom in Enum.GetValues<TimelineZoom>())
            {
                <button type="button" class="tl-zoom-btn" data-scale="@ZoomName(zoom)" aria-pressed="@(zoom == _zoom ? "true" : "false")"
                        @onclick="() => SetZoom(zoom)">@zoom</button>
            }
            <span class="tl-zoom-sep" aria-hidden="true"></span>
            <button type="button" class="icon-btn tl-zoom-icon" aria-label="Legend" title="Legend" aria-expanded="@(_legendOpen ? "true" : "false")"
                    @onclick="() => _legendOpen = !_legendOpen"><Icon Name="info" /></button>
            <button type="button" class="icon-btn tl-zoom-icon" aria-label="Full screen" title="Full screen" @onclick="ToggleFullScreenAsync"><Icon Name="fullscreen" /></button>
            @if (_legendOpen)
            {
                <div class="menu-backdrop" @onclick="() => _legendOpen = false"></div>
                <div class="tl-legend" role="region" aria-label="Legend" @onkeydown="@(e => { if (e.Key == "Escape") { _legendOpen = false; } })">
                    <p class="popover-title">Legend</p>
                    <ul>
                        @if (_colorByEpic)
                        {
                            <li><span class="tl-key-bar tl-c-epic tl-epic-purple"></span> A bar in its @(_view.Template == ProjectTemplate.StageGate ? "stage's" : "epic's") colour</li>
                        }
                        else
                        {
                            <li><span class="tl-key-bar tl-c-todo"></span> To do</li>
                            <li><span class="tl-key-bar tl-c-progress"></span> In progress</li>
                            <li><span class="tl-key-bar tl-c-done"></span> Done</li>
                        }
                        <li><span class="tl-key-line"></span> Today</li>
                        <li><span class="tl-key-shade"></span> This @(_zoom switch { TimelineZoom.Weeks => "week", TimelineZoom.Months => "month", _ => "quarter" })</li>
                        <li><svg width="28" height="10" aria-hidden="true"><path d="M1 5H24" class="tl-arrow" /><path d="M22 2L27 5L22 8z" class="tl-arrow-head" /></svg> Waits for</li>
                        <li><span class="tl-key-warning"><Icon Name="warning" Size="14" /></span> Starts before what it waits for is due</li>
                        <li><span class="tl-key-diamond">◆</span> Milestone</li>
                    </ul>
                    <p class="hint">Drag a bar to move it, or its ends to change its dates. Select a bar and use the arrow keys to move it by a day.</p>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(TaskKey))
    {
        <TaskDrawer WorkItemKey="@TaskKey" OnClose="CloseDrawer" OnChanged="LoadAsync" />
    }
    @if (_dependencyFor is { } dependencyFor)
    {
        <AddDependencyDialog @key="dependencyFor" ProjectKey="@_view.ProjectKey" ItemKey="@dependencyFor" OpenOnRender="true"
                             OnAdded="DependencyAddedAsync" OnClosed="() => _dependencyFor = null" />
    }
}

@code {
    private enum DateEnd { Both, Start, Due }

    private sealed record Pending(string Key, DateOnly? Start, DateOnly? Due);

    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);
    private readonly HashSet<string> _collapsedGroups = new(StringComparer.Ordinal);
    private string? _menuFor;
    private string? _dependencyFor;
    private bool _arrowsDrawn;
    private TimelineView? _view;
    private List<TimelineItem> _unscheduled = [];
    private int _unscheduledPage = 1;
    private bool _notFound;
    private bool? _loadedHide;
    private string? _error;
    private string? _conflict;
    private Pending? _pending;
    private Pending? _requested;
    private Task _saving = Task.CompletedTask;
    private readonly Dictionary<string, int> _failedSaves = new(StringComparer.Ordinal);
    private DateOnly _today;
    private TimelineZoom _zoom = TimelineZoom.Months;
    private (TimelineZoom Zoom, bool Hide)? _requestedView;
    private ElementReference _scroller;
    private DotNetObjectReference<TimelinePage>? _self;
    private bool _scriptReady;
    private string? _focusAfterRender;
    private string _search = "";
    private bool _settingsOpen;
    private bool _filterOpen;
    private bool _legendOpen;
    private bool _busy;
    private bool _scrollToToday;
    private const string NoOne = "none";
    private const string ColorsKey = "upms.timeline.epic-colours";
    private const string DependenciesKey = "upms.timeline.dependencies";
    private const string ProgressKey = "upms.timeline.progress";
    private readonly HashSet<string> _people = new(StringComparer.Ordinal);
    private readonly HashSet<StatusCategory> _categories = [];
    private readonly HashSet<WorkItemType> _kinds = [];
    private bool _colorByEpic;
    private bool _exportOpen;
    private bool _canExport;

    /// <summary>The export address with what the page shows: its scale, colours, filters and the viewer's today.</summary>
    private string ExportUrl(string format)
    {
        var query = new Dictionary<string, string?>
        {
            ["zoom"] = _zoom.ToString().ToLowerInvariant(),
            ["hide"] = _view?.HidingCompleted == true ? "true" : null,
            ["colors"] = _colorByEpic ? "epic" : null,
            ["q"] = Searching ? _search.Trim() : null,
            ["people"] = _people.Count > 0 ? string.Join(',', _people) : null,
            ["status"] = _categories.Count > 0 ? string.Join(',', _categories.Select(c => c.ToString().ToLowerInvariant())) : null,
            ["types"] = _kinds.Count > 0 ? string.Join(',', _kinds) : null,
            ["today"] = _today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture),
        };
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString($"spaces/{Uri.EscapeDataString(Key)}/timeline/export/{format}",
            query.Where(p => p.Value is not null));
    }

    /// <summary>Jira's "Image (PNG)": the browser draws the exported SVG on a canvas and saves it.</summary>
    private async Task DownloadPngAsync()
    {
        _exportOpen = false;
        var saved = await JS.InvokeAsync<bool>("upms.downloadSvgAsPng", ExportUrl("svg"),
            $"{Key}-timeline-{_today:yyyy-MM-dd}.png");
        Announcer.Announce(saved ? "Timeline image downloaded." : "The image could not be made. Try the SVG or PDF instead.");
    }
    private bool _showDependencies = true;
    private bool _showProgress = true;

    [Parameter]
    public string Key { get; set; } = "";

    /// <summary><c>?scale=weeks|months|quarters</c>; months when absent.</summary>
    [SupplyParameterFromQuery(Name = "scale")]
    public string? ScaleValue { get; set; }

    /// <summary><c>?completed=hide</c> leaves out completed tasks (FR-040).</summary>
    [SupplyParameterFromQuery(Name = "completed")]
    public string? CompletedValue { get; set; }

    /// <summary><c>?task={KEY-N}</c> opens the task's details drawer over the timeline (FR-040).</summary>
    [SupplyParameterFromQuery(Name = "task")]
    public string? TaskKey { get; set; }

    // A new scale or opening the drawer changes only the address: the timeline is not read again, and a change being
    // made with the keyboard stays pending.
    protected override async Task OnParametersSetAsync()
    {
        _canExport = (await Organization.MyAccessAsync(CancellationToken.None)).Can(Rights.Export);
        var zoom = Enum.GetValues<TimelineZoom>().FirstOrDefault(z => ZoomName(z) == ScaleValue?.Trim().ToLowerInvariant(), TimelineZoom.Months);
        _scrollToToday |= _scriptReady && zoom != _zoom; // a new scale starts at today again
        _zoom = zoom;
        var hide = CompletedValue == "hide";
        if (_requestedView == (_zoom, hide))
        {
            _requestedView = null;
        }
        if (_loadedHide != hide)
        {
            _loadedHide = hide;
            await LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!_scriptReady && _view is not null)
            {
                _scriptReady = true;
                _self = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("upms.timeline.init", _scroller, _self);
                await JS.InvokeVoidAsync("upms.timeline.scrollToToday", _scroller, false);
                await LoadOptionsAsync();
                StateHasChanged(); // the viewer's saved view settings
            }
            else if (_scrollToToday && _view is not null)
            {
                // A new scale starts at today again, as Jira's does.
                _scrollToToday = false;
                await JS.InvokeVoidAsync("upms.timeline.scrollToToday", _scroller, false);
            }

            // The arrows are drawn between the bars where the browser placed them (Phase 3 FR-050), unless turned off.
            var shown = _showDependencies && _view is not null ? _view.Dependencies : [];
            if (_view is not null && (shown.Count > 0 || _arrowsDrawn))
            {
                _arrowsDrawn = shown.Count > 0;
                await JS.InvokeVoidAsync("upms.timeline.drawArrows", _scroller,
                    shown.Select(d => new { from = d.WaitedForKey, to = d.WaitingKey, late = d.IsLate }).ToArray());
            }

            if (_focusAfterRender is { } id && string.IsNullOrEmpty(TaskKey))
            {
                _focusAfterRender = null;
                await JS.InvokeVoidAsync("upms.focusByIdIfLost", id);
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>Called by timeline.js when a bar or one of its ends was dragged by whole days. The offset comes from the
    /// browser: one longer than the span of dates a task may have (1 Jan 2000 to 31 Dec 2099) cannot come from a drag
    /// and is ignored.</summary>
    [JSInvokable]
    public async Task OnBarDragged(string key, string mode, int days)
    {
        const int MaxDragDays = 36_524;
        if (_view is not { CanContribute: true } || days is 0 or < -MaxDragDays or > MaxDragDays || Find(key) is not { IsScheduled: true } item)
        {
            return;
        }

        var (first, last) = DatesOf(item);
        // A milestone has one date and no handles: whatever the browser says, it only moves (Phase 3 security review F1).
        (DateOnly? Start, DateOnly? Due) next = (item.Type == WorkItemType.Milestone ? "move" : mode) switch
        {
            // An end never passes the other end (FR-037).
            "start" => ((first ?? last)!.Value.AddDays(days) is var start && last is { } due && start > due ? due : start, last),
            "end" => (first, (last ?? first)!.Value.AddDays(days) is var end && first is { } begin && end < begin ? begin : end),
            _ => (first?.AddDays(days), last?.AddDays(days)),
        };
        _pending = null;
        await SaveAsync(item, next.Start, next.Due);
        StateHasChanged();
    }

    // An item made with the Create form in this space shows at once.
    protected override void OnInitialized() => Launcher.Created += OnCreated;

    private void OnCreated(string spaceKey, string itemKey)
    {
        if (string.Equals(spaceKey, Key, StringComparison.OrdinalIgnoreCase))
        {
            _ = InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        Launcher.Created -= OnCreated;
        _self?.Dispose();
    }

    private static string ZoomName(TimelineZoom zoom) => zoom.ToString().ToLowerInvariant();

    private static string Px(double pixels) => pixels.ToString("0.##", CultureInfo.InvariantCulture) + "px";

    private static string LinkId(string key) => $"tl-task-{key}";

    private static string Long(DateOnly date) => date.ToString("d MMM yyyy", CultureInfo.InvariantCulture);

    private async Task LoadAsync()
    {
        _today = await ViewerToday.GetAsync();
        var result = await Timelines.GetAsync(Key, CompletedValue == "hide", CancellationToken.None);
        if (!result.IsSuccess)
        {
            // Someone removed from the team meanwhile sees what they may see now: "not found" (Phase 2 FR-011).
            _view = null;
            _notFound = result.Error!.Kind is ErrorKind.NotFound or ErrorKind.Forbidden;
            _error = _notFound ? null : result.Error.Message;
            return;
        }

        _notFound = false;
        _view = result.Value!;
        _unscheduled = [.. _view.Unscheduled.Items];
        _unscheduledPage = 1;
    }

    private IEnumerable<DateOnly> ScheduledDates()
    {
        var items = AllItems().Select(Shown).SelectMany(i => new[] { i.StartDate, i.DueDate }).OfType<DateOnly>();
        var sprints = _view!.Sprints.SelectMany(s => new[] { s.StartDate, s.EndDate });
        return items.Concat(sprints);
    }

    /// <summary>Every item shown, in groups or not: containers, their items and sub-tasks, and the unscheduled ones.</summary>
    private IEnumerable<TimelineItem> AllItems()
    {
        if (_view is null)
        {
            return [];
        }

        var rows = _view.Groups.SelectMany(g => g.Rows).Concat(_view.Rows);
        return _view.Groups.SelectMany(g => g.Unscheduled.Prepend(g.Container))
            .Concat(rows.SelectMany(r => r.ScheduledSubtasks.Prepend(r.Task)));
    }

    /// <summary>The item at the dates of a change still being made with the keyboard.</summary>
    private TimelineItem Shown(TimelineItem item) =>
        _pending is { } pending && pending.Key == item.Key ? item with { StartDate = pending.Start, DueDate = pending.Due } : item;

    private TimelineItem? Find(string key) => AllItems().FirstOrDefault(i => i.Key == key);

    /// <summary>Whether the item waits for another or is waited for.</summary>
    private bool IsLinked(string key) =>
        _view is not null && (_view.Dependencies.Any(d => d.WaitedForKey == key || d.WaitingKey == key)
            || AllItems().Any(i => (i.Key == key && i.WaitsFor.Count > 0) || i.WaitsFor.Any(w => w.Key == key)));

