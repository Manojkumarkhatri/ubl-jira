        (!Searching || item.Title.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase)
            || item.Key.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
        && (_people.Count == 0 || _people.Contains(item.Assignee?.UserId.ToString() ?? NoOne))
        && (_categories.Count == 0 || _categories.Contains(item.Status.Category))
        && (_kinds.Count == 0 || _kinds.Contains(item.Type));

