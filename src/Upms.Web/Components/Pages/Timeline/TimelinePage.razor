    // ----- Keyboard rescheduling (FR-038) -----

    private async Task BarKeyDownAsync(TimelineItem item, KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowLeft" or "ArrowRight" when _view!.CanContribute:
                // A milestone has one date: Shift and Ctrl move it like a plain arrow (Phase 3 FR-043).
                Adjust(item, e.Key == "ArrowRight" ? 1 : -1,
                    item.Type == WorkItemType.Milestone ? DateEnd.Both : e.ShiftKey ? DateEnd.Due : e.CtrlKey ? DateEnd.Start : DateEnd.Both);
                break;
            case "Enter":
                await ActivateAsync(item);
                break;
            case "Escape" when _pending?.Key == item.Key:
                _pending = null;
                Announcer.Announce($"Change to {item.Key} cancelled.");
                break;
        }
    }

    /// <summary>Saves a pending change, or opens the task when there is none.</summary>
    private async Task ActivateAsync(TimelineItem item)
    {
        if (_pending is { } pending && pending.Key == item.Key && _view!.CanContribute)
        {
            _pending = null;
            await SaveAsync(item, pending.Start, pending.Due);
        }
        else
        {
            OpenDrawer(item.Key);
        }
    }

    private void Adjust(TimelineItem item, int days, DateEnd end)
    {
        var (start, due) = DatesOf(item);
        switch (end)
        {
            case DateEnd.Due:
                var newDue = (due ?? start)!.Value.AddDays(days);
                if (start is { } s && newDue < s)
                {
                    Announcer.Announce("The due date cannot be before the start date.");
                    return;
                }

                due = newDue;
                break;
            case DateEnd.Start:
                var newStart = (start ?? due)!.Value.AddDays(days);
                if (due is { } d && newStart > d)
                {
                    Announcer.Announce("The start date cannot be after the due date.");
                    return;
                }

                start = newStart;
                break;
            default:
                start = start?.AddDays(days);
                due = due?.AddDays(days);
                break;
        }

        _pending = new Pending(item.Key, start, due);
        Announcer.Announce($"{item.Key}: {TimelineBar.DatesText(start, due)}. Enter saves, Escape cancels.");
    }

    // ----- Saving (FR-039) -----

    /// <summary>The dates a new change starts from: the change being made, else the latest one still being saved, else
    /// the task's own.</summary>
    private (DateOnly? Start, DateOnly? Due) DatesOf(TimelineItem item) =>
        _pending is { } pending && pending.Key == item.Key ? (pending.Start, pending.Due)
        : _requested is { } requested && requested.Key == item.Key ? (requested.Start, requested.Due)
        : Find(item.Key) is { } current ? (current.StartDate, current.DueDate)
        : (item.StartDate, item.DueDate);

    /// <summary>Saves one change at a time, in the order asked: over a slow connection the next key can arrive before a
    /// save answers, and each save needs the version the one before it returned. When a save fails, the changes to the
    /// same task queued behind it, which were built on it, are dropped.</summary>
    private async Task<bool> SaveAsync(TimelineItem item, DateOnly? start, DateOnly? due, string? savedMessage = null)
    {
        var request = new Pending(item.Key, start, due);
        _requested = request;
        var failuresBefore = _failedSaves.GetValueOrDefault(item.Key);
        var previous = _saving;
        var done = new TaskCompletionSource();
        _saving = done.Task;
        try
        {
            await previous;
            return failuresBefore == _failedSaves.GetValueOrDefault(item.Key) && await SaveNowAsync(Find(item.Key) ?? item, start, due, savedMessage);
        }
        finally
        {
            if (ReferenceEquals(_requested, request))
            {
                _requested = null;
            }

            done.SetResult();
        }
    }

    private async Task<bool> SaveNowAsync(TimelineItem item, DateOnly? start, DateOnly? due, string? savedMessage)
    {
        var result = await Timelines.RescheduleAsync(item.Key, start, due, item.Version, CancellationToken.None);
        if (result.IsSuccess)
        {
            _conflict = null;
            _error = null;
            Replace(result.Value!);
            if (IsLinked(item.Key))
            {
                await LoadAsync(); // the server works out again which of its links are late (Phase 3 FR-051)
            }

            Announcer.Announce(savedMessage ?? (start, due) switch
            {
                ({ } s, { } d) => $"{item.Key} now runs from {Long(s)} to {Long(d)}.",
                (null, { } d) => $"{item.Key} is now due {Long(d)}.",
                ({ } s, null) => $"{item.Key} now starts {Long(s)}.",
                _ => $"{item.Key} has no dates now.",
            });
            return true;
        }

        var error = result.Error!;
        if (error.Kind == ErrorKind.Conflict && error.Current is TimelineItem current)
        {
            // Someone else changed the task: show its current dates rather than overwrite them.
            Replace(current);
            _conflict = error.Message;
        }
        else if (error.Kind is ErrorKind.NotFound or ErrorKind.Forbidden)
        {
            _error = error.Message;
            await LoadAsync();
        }
        else
        {
            _error = error.MessageFor("DueDate");
        }

        _failedSaves[item.Key] = _failedSaves.GetValueOrDefault(item.Key) + 1;
        Announcer.Announce(_conflict ?? _error ?? error.Message);
        return false;
    }

    private void Replace(TimelineItem item)
    {
        if (_view is null)
        {
            return;
        }

        // A saved item keeps its type and what it waits for, which a reschedule does not read again.
        TimelineItem Swap(TimelineItem existing) => existing.Key == item.Key ? item with { Type = existing.Type, WaitsFor = existing.WaitsFor } : existing;
        TimelineRow SwapRow(TimelineRow r) => r with { Task = Swap(r.Task), ScheduledSubtasks = r.ScheduledSubtasks.Select(Swap).ToList() };
        _view = _view with
        {
            Rows = _view.Rows.Select(SwapRow).ToList(),
            Groups = _view.Groups.Select(g => g with
            {
                Container = Swap(g.Container),
                Rows = g.Rows.Select(SwapRow).ToList(),
                Unscheduled = g.Unscheduled.Select(Swap).ToList(),
            }).ToList(),
        };
    }

    // ----- Unscheduled tasks (FR-036) -----

    /// <summary>A task gets a week from today, an epic or stage four weeks, and a milestone today (Phase 3 FR-043).</summary>
    private async Task ScheduleAsync(TimelineItem item)
    {
        var (start, due) = item.Type switch
        {
            WorkItemType.Milestone => ((DateOnly?)null, (DateOnly?)_today),
            WorkItemType.Epic or WorkItemType.Stage => (_today, _today.AddDays(27)),
            _ => (_today, _today.AddDays(6)),
        };
        var message = start is null ? $"{item.Key} scheduled on {Long(due!.Value)}." : $"{item.Key} scheduled from {Long(start.Value)} to {Long(due!.Value)}.";
        if (await SaveAsync(item, start, due, message))
        {
            await LoadAsync();
            _focusAfterRender = TimelineBar.IdFor(item.Key); // its "Schedule" button is gone; the new bar takes focus
        }
    }

    private async Task ShowMoreUnscheduledAsync()
    {
        var result = await Timelines.ListUnscheduledAsync(Key, CompletedValue == "hide", new PageRequest(_unscheduledPage + 1), CancellationToken.None);
        if (!result.IsSuccess)
        {
            _error = result.Error!.Message;
            return;
        }

        _unscheduledPage = result.Value!.PageNumber;
        var known = _unscheduled.Select(i => i.Key).ToHashSet(StringComparer.Ordinal);
        _unscheduled.AddRange(result.Value.Items.Where(i => !known.Contains(i.Key)));
    }
}
