    /// <summary>Changes an item's status from its Status cell, with the same rules as the board and the drawer.</summary>
    private async Task StatusChangedAsync(TimelineItem item, ChangeEventArgs e)
    {
        if (_busy || !long.TryParse(e.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out var id) || id == item.Status.Id)
        {
            return;
        }

        _busy = true;
        try
        {
            var saved = await Items.UpdateAsync(item.Key, new WorkItemEdit.Status(id), item.Version, CancellationToken.None);
            if (saved.IsSuccess)
            {
                Announcer.Announce($"{item.Key} moved to {_view!.Statuses.First(s => s.Id == id).Name}.");
            }
            else
            {
                _error = saved.Error!.Kind == ErrorKind.Conflict
                    ? $"{item.Key} was changed by someone else. The timeline now shows the latest."
                    : $"{item.Key}: {saved.Error.Message}";
            }

            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

