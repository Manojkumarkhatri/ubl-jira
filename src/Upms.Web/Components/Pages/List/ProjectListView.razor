@page "/spaces/{Key}/list"
@using System.Globalization
@using Upms.Application.Work
@using Upms.Domain.Common
@using Upms.Domain.Work
@using Upms.Web.Components.Pages.Board
@using Upms.Web.Components.Pages.Drawer
@inject IWorkItemListService Lists
@inject IWorkItemService Items
@inject ViewerToday ViewerToday
@inject LiveAnnouncer Announcer
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject CreateWorkLauncher Launcher
@implements IDisposable

<PageTitle>@(_view?.ProjectName ?? Key) · List · U-PMS</PageTitle>

@* The List view, laid out as Jira's (Phase 2 FR-027–FR-033; Phase 3 FR-020): a search, the people, "Filter" and "Group"
   above one table of work items with the columns the viewer chose, sorted and filtered in SQL, with the state in the
   address so a list can be bookmarked and shared. Rows can be selected to change several at once. *@
@if (_notFound)
{
    <NotFoundContent />
}
else if (_view is null)
{
    <p aria-busy="true">Loading the list…</p>
}
else
{
    <ProjectHeader ProjectKey="@_view.ProjectKey" Title="@_view.ProjectName" Current="ProjectPage.List" Template="_view.Template"
                   CanManage="_view.CanManage" CanRestoreDeleted="_view.CanRestoreDeleted" />

    @if (_error is not null)
    {
        <div class="alert alert-error" role="alert">
            @_error
            <button type="button" class="btn btn-sm btn-ghost" @onclick="() => _error = null">Dismiss</button>
        </div>
    }

    <div class="board-toolbar list-toolbar">
        <form class="board-search" role="search" @onsubmit="SearchNow" @onsubmit:preventDefault>
            <Icon Name="search" />
            <label class="sr-only" for="list-search">Search work</label>
            <input id="list-search" class="input" type="search" placeholder="Search work" autocomplete="off" maxlength="100"
                   value="@_textDraft" @oninput="SearchTypedAsync" />
        </form>
        <div class="avatar-filter" role="group" aria-label="Filter by assignee">
            <button type="button" class="avatar-toggle @(State.Unassigned ? "is-on" : "")" aria-pressed="@(State.Unassigned ? "true" : "false")"
                    title="Unassigned" @onclick="() => Go(Latest.ToggleUnassigned())">
                <span class="avatar avatar-unassigned" aria-hidden="true"><Icon Name="person" Size="14" /></span>
                <span class="sr-only">Unassigned</span>
            </button>
            @if (_view.People.FirstOrDefault(p => p.IsMe) is { } me)
            {
                <button type="button" class="avatar-toggle @(State.Me ? "is-on" : "")" aria-pressed="@(State.Me ? "true" : "false")"
                        title="@me.DisplayName (you)" @onclick="() => Go(Latest.ToggleMe())">
                    <Avatar UserId="me.UserId" Initials="@AssigneeRef.InitialsOf(me.DisplayName)" />
                    <span class="sr-only">Assigned to me</span>
                </button>
            }
            @foreach (var person in _view.People.Where(p => !p.IsMe).Take(6))
            {
                var on = State.People.Contains(person.UserId);
                <button type="button" class="avatar-toggle @(on ? "is-on" : "")" aria-pressed="@(on ? "true" : "false")" title="@person.DisplayName"
                        @onclick="() => Go(Latest.TogglePerson(person.UserId))">
                    <Avatar UserId="person.UserId" Initials="@AssigneeRef.InitialsOf(person.DisplayName)" />
                    <span class="sr-only">@person.DisplayName</span>
                </button>
            }
        </div>
        <div class="toolbar-pop">
            <button type="button" class="btn btn-sm toolbar-btn @(State.FilterCount > 0 ? "is-on" : "")" aria-expanded="@(_panel == Panel.Filter ? "true" : "false")"
                    aria-controls="list-filter-panel" @onclick="() => Toggle(Panel.Filter)">
                <Icon Name="filter" /> Filter@(State.FilterCount > 0 ? $" ({State.FilterCount})" : "")
            </button>
            @if (_panel == Panel.Filter)
            {
                <div class="menu-backdrop" @onclick="() => _panel = Panel.None"></div>
                <div id="list-filter-panel" class="toolbar-panel list-filter-panel" role="group" aria-label="Filter work items" @onkeydown="PanelKeyDown">
                    <p class="panel-heading">Work type</p>
                    <div class="quick-filters">
                        @foreach (var kind in FilterKinds)
                        {
                            var pressed = State.ItemTypes.Contains(kind);
                            <button type="button" class="btn btn-sm quick @(pressed ? "active" : "")" aria-pressed="@(pressed ? "true" : "false")"
                                    @onclick="() => Go(Latest.ToggleItemType(kind))"><TypeIcon Type="kind" /> @WorkItemTypes.DisplayName(kind)</button>
                        }
                    </div>
                    <p class="panel-heading">Status</p>
                    <div class="quick-filters">
                        @foreach (var column in _view.Columns)
                        {
                            var pressed = State.Columns.Contains(column.Id);
                            <button type="button" class="btn btn-sm quick @(pressed ? "active" : "")" aria-pressed="@(pressed ? "true" : "false")"
                                    @onclick="() => Go(Latest.ToggleColumn(column.Id))">@column.Name</button>
                        }
                    </div>
                    <p class="panel-heading">Priority</p>
                    <div class="quick-filters">
                        @foreach (var priority in Enum.GetValues<Priority>())
                        {
                            var pressed = State.Priorities.Contains(priority);
                            <button type="button" class="btn btn-sm quick @(pressed ? "active" : "")" aria-pressed="@(pressed ? "true" : "false")"
                                    @onclick="() => Go(Latest.TogglePriority(priority))"><PriorityIcon Priority="priority" /> @priority</button>
                        }
                    </div>
                    <p class="panel-heading">@ContainerLabel</p>
                    <div class="quick-filters">
                        <button type="button" class="btn btn-sm quick @(State.NoContainer ? "active" : "")" aria-pressed="@(State.NoContainer ? "true" : "false")"
                                @onclick="() => Go(Latest.ToggleNoContainer())">None</button>
                        @foreach (var container in _containers)
                        {
                            var pressed = State.Containers.Contains(container.Key);
                            <button type="button" class="btn btn-sm quick @(pressed ? "active" : "")" aria-pressed="@(pressed ? "true" : "false")"
                                    title="@container.Key @container.Title" @onclick="() => Go(Latest.ToggleContainer(container.Key))">@container.Title</button>
                        }
                    </div>
                    <p class="panel-heading">Label</p>
                    <div class="quick-filters">
                        @foreach (var label in LabelChoices)
                        {
                            var pressed = State.Labels.Contains(label, StringComparer.OrdinalIgnoreCase);
                            <button type="button" class="btn btn-sm quick label-toggle @(pressed ? "active" : "")" aria-pressed="@(pressed ? "true" : "false")"
                                    @onclick="() => Go(Latest.ToggleLabel(label))">@label</button>
                        }
                    </div>
                    <form class="label-add" @onsubmit="AddLabelFilter" @onsubmit:preventDefault>
                        <label class="sr-only" for="filter-label">Another label</label>
                        <input id="filter-label" class="input" maxlength="50" autocomplete="off" placeholder="Another label…" @bind="_labelDraft" />
                    </form>
                    <p class="panel-heading">Due date</p>
                    <div class="quick-filters">
                        @foreach (var due in new[] { DueFilter.Overdue, DueFilter.Next7Days, DueFilter.NoDueDate })
                        {
                            var pressed = State.Due == due;
                            <button type="button" class="btn btn-sm quick @(pressed ? "active" : "")" aria-pressed="@(pressed ? "true" : "false")"
                                    @onclick="() => Go(Latest.WithDue(pressed ? DueFilter.Any : due))">@DueLabel(due)</button>
                        }
                    </div>
                    @if (State.HasFilters)
                    {
                        <button type="button" class="btn btn-sm btn-ghost panel-clear" data-testid="clear-filters" @onclick="ClearFilters">Clear filters</button>
                    }
                </div>
            }
        </div>
        <div class="toolbar-pop">
            <button type="button" class="btn btn-sm toolbar-btn @(Group != ListGroup.None ? "is-on" : "")" aria-expanded="@(_panel == Panel.Group ? "true" : "false")"
                    aria-controls="list-group-panel" @onclick="() => Toggle(Panel.Group)">
                <Icon Name="group" /> Group@(Group != ListGroup.None ? $": {GroupLabel(Group)}" : "")
            </button>
            @if (_panel == Panel.Group)
            {
                <div class="menu-backdrop" @onclick="() => _panel = Panel.None"></div>
                <div id="list-group-panel" class="toolbar-panel" role="radiogroup" aria-label="Group by" @onkeydown="PanelKeyDown">
                    @foreach (var group in Enum.GetValues<ListGroup>())
                    {
                        <label class="group-choice">
                            <input type="radio" name="list-group" checked="@(Group == group)" @onchange="() => SetGroup(group)" />
                            @GroupLabel(group)
                        </label>
                    }
                </div>
            }
        </div>
        @if (State.HasFilters)
        {
            <button type="button" class="btn btn-sm btn-ghost" @onclick="ClearFilters">Clear filters</button>
        }
        <span class="spacer"></span>
        <div class="toolbar-pop">
            <button type="button" class="icon-btn list-more" aria-label="More list actions" title="More" aria-expanded="@(_panel == Panel.More ? "true" : "false")"
                    @onclick="() => Toggle(Panel.More)"><Icon Name="more" /></button>
            @if (_panel == Panel.More)
            {
                <div class="menu-backdrop" @onclick="() => _panel = Panel.None"></div>
                <ul class="column-menu-list" role="menu" aria-label="More list actions" @onkeydown="PanelKeyDown">
                    <li role="none"><button type="button" role="menuitem" class="column-menu-item" @onclick="ClearFilters">Clear filters</button></li>
                    <li role="none"><button type="button" role="menuitem" class="column-menu-item" @onclick="ResetSort">Reset sorting</button></li>
                    <li role="none"><button type="button" role="menuitem" class="column-menu-item" @onclick="ResetColumnsAsync">Reset columns</button></li>
                </ul>
            }
        </div>
    </div>

    @if (_selected.Count > 0)
    {
        <div class="bulk-bar" role="region" aria-label="Selected work items">
            <b>@_selected.Count selected</b>
            <select class="select select-sm" aria-label="Change the status of the selected items" disabled="@_busy" @onchange="BulkStatusAsync">
                <option value="">Change status…</option>
                @foreach (var column in _view.Columns)
                {
                    <option value="@column.Id">@column.Name</option>
                }
            </select>
            <select class="select select-sm" aria-label="Change the priority of the selected items" disabled="@_busy" @onchange="BulkPriorityAsync">
                <option value="">Change priority…</option>
                @foreach (var priority in Enum.GetValues<Priority>())
                {
                    <option value="@priority">@priority</option>
                }
            </select>
            <select class="select select-sm" aria-label="Assign the selected items" disabled="@_busy" @onchange="BulkAssignAsync">
                <option value="">Assign…</option>
                <option value="@ListState.UnassignedValue">Unassigned</option>
                @foreach (var person in _view.People)
                {
                    <option value="@person.UserId">@person.DisplayName@(person.IsMe ? " (me)" : "")</option>
                }
            </select>
            <button type="button" class="btn btn-sm btn-ghost btn-danger" data-testid="bulk-delete" disabled="@_busy" @onclick="AskDeleteAsync">
                <Icon Name="trash" Size="14" /> Delete
            </button>
            <button type="button" class="btn btn-sm btn-ghost" @onclick="() => _selected.Clear()">Clear selection</button>
        </div>
    }
    <DeleteWorkItemsDialog @ref="_deleteDialog" OnDeleted="DeletedAsync" OnProblem="problem => _error = problem" />

    <div class="list-card">
        <div class="list-scroll" role="region" aria-label="Work items" tabindex="0">
            <table class="list-grid">
                <caption class="sr-only">Work items of @_view.ProjectName</caption>
                <thead>
                    <tr>
                        <th scope="col" class="col-check">
                            <input type="checkbox" aria-label="Select every work item on this page" checked="@AllSelected"
                                   disabled="@(_view.Rows.Items.Count == 0)" @onchange="ToggleAll" />
                        </th>
                        @HeaderCell("work", "Work", ListSort.Key, "col-work")
                        @foreach (var column in VisibleColumns)
                        {
                            @HeaderCell(column.Id, column.Label, column.Sort, $"col-{column.Id}")
                        }
                        <th scope="col" class="col-pick">
                            <button type="button" class="icon-btn" aria-label="Choose columns" title="Columns" aria-expanded="@(_panel == Panel.Columns ? "true" : "false")"
                                    aria-controls="list-columns" @onclick="() => Toggle(Panel.Columns)"><Icon Name="board" /></button>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (_view.Rows.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="@(VisibleColumns.Count + 3)" class="list-empty">
                                @if (State.HasFilters)
                                {
                                    <p>No work items match these filters.</p>
                                    <button type="button" class="btn btn-sm" data-testid="empty-clear-filters" @onclick="ClearFilters">Clear filters</button>
                                }
                                else
                                {
                                    <p>No work items yet.</p>
                                }
                            </td>
                        </tr>
                    }
                    @foreach (var group in Groups())
                    {
                        @if (Group != ListGroup.None)
                        {
                            var open = !_collapsed.Contains(group.Id);
                            <tr class="group-row" @key="@($"g-{group.Id}")">
                                <td colspan="@(VisibleColumns.Count + 3)">
                                    <button type="button" class="group-toggle" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleGroup(group.Id)">
                                        <Icon Name="@(open ? "chevron-down" : "chevron-right")" Size="14" />
                                        @GroupHead(group.Rows[0])
                                        <span class="group-count">@group.Rows.Count @(group.Rows.Count == 1 ? "work item" : "work items")</span>
                                    </button>
                                </td>
                            </tr>
                            @if (!open)
                            {
                                continue;
                            }
                        }
                        @foreach (var row in group.Rows)
                        {
                            @RowView(row)
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_panel == Panel.Columns)
        {
            <div class="menu-backdrop" @onclick="() => _panel = Panel.None"></div>
            <div id="list-columns" class="tab-popover list-columns" role="group" aria-label="Columns" @onkeydown="PanelKeyDown">
                <p class="popover-title">Columns</p>
                <label class="filter-option is-fixed"><input type="checkbox" checked disabled /> Work</label>
                @foreach (var column in AllColumns)
                {
                    <label class="filter-option"><input type="checkbox" checked="@_columns.Contains(column.Id)" @onchange="() => ToggleColumnAsync(column.Id)" /> @column.Label</label>
                }
            </div>
        }
        <div class="list-footer">
            <div class="list-footer-start">
                @if (_view.CanContribute)
                {
                    @if (_creating)
                    {
                        <div class="list-create">
                            <InlineCreate ColumnName="@FirstToDoName" Types="CreateTypes" DefaultType="DefaultCreateType" OnCreate="CreateAsync"
                                          OnCancel="() => _creating = false" AutoFocus="true" />
                        </div>
                    }
                    else
                    {
                        <button type="button" class="tl-create" @onclick="() => _creating = true"><Icon Name="plus" Size="14" /> Create</button>
                    }
                }
            </div>
            <div class="list-count">
                <span data-testid="list-count" role="status">@CountText</span>
                <button type="button" class="icon-btn" aria-label="Refresh the list" title="Refresh" @onclick="LoadAsync"><Icon Name="refresh" Size="14" /></button>
            </div>
            <div class="list-pager">
                @if (_view.Rows.PageCount > 1)
                {
                    <span class="hint">Page @_view.Rows.PageNumber of @_view.Rows.PageCount</span>
                    <button type="button" class="icon-btn" aria-label="Previous page" disabled="@(_view.Rows.PageNumber <= 1)"
                            @onclick="() => Go(Latest.WithPage(_view.Rows.PageNumber - 1))"><Icon Name="chevron-right" Class="flip" /></button>
                    <button type="button" class="icon-btn" aria-label="Next page" disabled="@(_view.Rows.PageNumber >= _view.Rows.PageCount)"
                            @onclick="() => Go(Latest.WithPage(_view.Rows.PageNumber + 1))"><Icon Name="chevron-right" /></button>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(TaskKey))
    {
        <TaskDrawer WorkItemKey="@TaskKey" OnClose="CloseDrawer" OnChanged="LoadAsync" />
    }
}

@code {
    private enum Panel
    {
        None,
        Filter,
        Group,
        More,
        Columns,
    }

    private enum ListGroup
    {
        None,
        Status,
        Assignee,
        Priority,
        Epic,
        Type,
    }

    private sealed record ListColumn(string Id, string Label, ListSort? Sort, bool ShownByDefault);

    private sealed record RowGroup(string Id, List<WorkItemRow> Rows);

    private const string ColumnsKey = "upms.list.columns";
    private IReadOnlyList<ContainerOption> _containers = [];
    private WorkItemListView? _view;
    private bool _notFound;
    private string? _error;
    private string? _loadedAddress;
    private string _textDraft = "";
    private string _labelDraft = "";
    private DateOnly _today;
    private string? _focusKey;
    private Panel _panel;
    private HashSet<string> _columns = [];
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private readonly HashSet<string> _collapsed = new(StringComparer.Ordinal);
    private bool _creating;
    private bool _busy;
    private CancellationTokenSource? _typing;

    [Parameter]
    public string Key { get; set; } = "";

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortValue { get; set; }

    [SupplyParameterFromQuery(Name = "dir")]
    public string? DirectionValue { get; set; }

    [SupplyParameterFromQuery(Name = "column")]
    public string? ColumnsValue { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    public string? TypesValue { get; set; }

    [SupplyParameterFromQuery(Name = "priority")]
    public string? PrioritiesValue { get; set; }

    [SupplyParameterFromQuery(Name = "assignee")]
    public string? AssigneesValue { get; set; }

    [SupplyParameterFromQuery(Name = "due")]
    public string? DueValue { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? TextValue { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageValue { get; set; }

    /// <summary>Work item types (Phase 3 FR-020); <c>type</c> is the status type, as in Phase 2.</summary>
    [SupplyParameterFromQuery(Name = "kind")]
    public string? KindsValue { get; set; }

    [SupplyParameterFromQuery(Name = "container")]
    public string? ContainersValue { get; set; }

    /// <summary>Phase 4 FR-046: items with any of these labels.</summary>
    [SupplyParameterFromQuery(Name = "labels")]
    public string? LabelsValue { get; set; }

    /// <summary><c>?group=status|assignee|priority|epic|type</c>: rows of the page under a heading per value, as Jira's
    /// "Group".</summary>
    [SupplyParameterFromQuery(Name = "group")]
    public string? GroupValue { get; set; }

    /// <summary><c>?task={KEY-N}</c> opens the task's details drawer over the list (FR-032).</summary>
    [SupplyParameterFromQuery(Name = "task")]
    public string? TaskKey { get; set; }

    private ListState State { get; set; } = ListState.Default;

    // A new address reaches the page only after a round trip through the browser: a choice made meanwhile builds on the
    // one asked for last, not on the address still shown (FR-030).
    private ListState? _requested;

    private ListState Latest => _requested ?? State;

    private ListGroup Group => Enum.TryParse<ListGroup>(GroupValue, ignoreCase: true, out var group) ? group : ListGroup.None;

    private string FirstToDoName => _view!.Columns.FirstOrDefault(c => c.Id == _view.FirstToDoColumnId)?.Name ?? "To Do";

    private string CountText => string.Create(System.Globalization.CultureInfo.CurrentCulture, $"{_view!.Rows.Items.Count:N0} of {_view.Rows.TotalCount:N0}");

    private bool IsStageGate => _view?.Template == ProjectTemplate.StageGate;

    /// <summary>"Epic" in agile spaces, "Stage" in Stage-gate spaces.</summary>
    private string ContainerLabel => IsStageGate ? "Stage" : "Epic";

    /// <summary>Jira's list columns besides Work; the first eight show until the viewer chooses others.</summary>
    private IReadOnlyList<ListColumn> AllColumns =>
    [
        new("assignee", "Assignee", ListSort.Assignee, true),
        new("reporter", "Reporter", null, true),
        new("priority", "Priority", ListSort.Priority, true),
        new("status", "Status", ListSort.Status, true),
        new("resolution", "Resolution", null, true),
        new("created", "Created", ListSort.Created, true),
        new("updated", "Updated", ListSort.Updated, true),
        new("due", "Due date", ListSort.DueDate, true),
        new("start", "Start date", ListSort.StartDate, false),
        new("parent", ContainerLabel, null, false),
        new("labels", "Labels", null, false),
        new("type", "Work type", ListSort.Type, false),
        // The space's own fields, offered in "Choose columns" (live test, 2026-10-28).
        .. (_view?.Fields ?? []).Select(f => new ListColumn(FieldColumnPrefix + f.Id.ToString(System.Globalization.CultureInfo.InvariantCulture), f.Name, null, false)),
    ];

    private const string FieldColumnPrefix = "field-";

    private List<ListColumn> VisibleColumns => AllColumns.Where(c => _columns.Contains(c.Id)).ToList();

    /// <summary>The types a space's items can have (Phase 3 FR-010).</summary>
    private IReadOnlyList<WorkItemType> FilterKinds => IsStageGate
        ? [WorkItemType.Stage, WorkItemType.Task, WorkItemType.Milestone, WorkItemType.Subtask]
        : [WorkItemType.Epic, WorkItemType.Story, WorkItemType.Task, WorkItemType.Bug, WorkItemType.Subtask];

    /// <summary>The types the caller may create here: sub-tasks are added from their parent, and stages only by Space
    /// admins (FR-020).</summary>
    private IReadOnlyList<WorkItemType> CreateTypes => IsStageGate
        ? _view!.CanManage ? [WorkItemType.Task, WorkItemType.Milestone, WorkItemType.Stage] : [WorkItemType.Task, WorkItemType.Milestone]
        : new[] { WorkItemType.Task, WorkItemType.Story, WorkItemType.Bug, WorkItemType.Epic }
            .Where(t => WorkItemTypes.IsOffered(t, _view!.Template, _view.WorkTypes))
            .ToList();

    private WorkItemType DefaultCreateType => CreateTypes.Contains(WorkItemType.Task) ? WorkItemType.Task : CreateTypes[0];

    /// <summary>The labels on the rows shown and those already chosen, offered as filters (Phase 4 FR-046).</summary>
    private IReadOnlyList<string> LabelChoices => (_view?.Rows.Items.SelectMany(r => r.Labels) ?? [])
        .Concat(State.Labels)
        .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToList();

    private bool AllSelected => _view!.Rows.Items.Count > 0 && _view.Rows.Items.All(r => _selected.Contains(r.Key));

    protected override void OnInitialized()
    {
        _columns = AllColumns.Where(c => c.ShownByDefault).Select(c => c.Id).ToHashSet();
        Launcher.Created += OnCreated;
    }

    // Opening or closing the drawer, or grouping, changes only the address: the list is not read again.
    protected override async Task OnParametersSetAsync()
    {
        State = ListState.Parse(SortValue, DirectionValue, ColumnsValue, TypesValue, PrioritiesValue, AssigneesValue, DueValue, TextValue, PageValue,
            KindsValue, ContainersValue, LabelsValue);
        var address = AddressOf(State);
        var asked = _requested is { } requested && AddressOf(requested) == address;
        if (asked)
        {
            _requested = null;
        }

        if (address == _loadedAddress)
        {
            return;
        }

        _loadedAddress = address;
        if (!asked)
        {
            _textDraft = State.Text; // a search being typed is not overwritten by the answer to an earlier one
        }

        _selected.Clear();
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender && await JS.InvokeAsync<string?>("upms.store.get", ColumnsKey) is { Length: > 0 } saved)
            {
                // Space-field columns are kept too: the fields may not have loaded yet, and only existing ones show.
                var known = AllColumns.Select(c => c.Id).ToHashSet();
                _columns = saved.Split(',').Where(c => known.Contains(c) || c.StartsWith(FieldColumnPrefix, StringComparison.Ordinal)).ToHashSet();
                StateHasChanged();
            }

            if (_focusKey is { } key && string.IsNullOrEmpty(TaskKey))
            {
                // Focus returns to the row whose drawer was closed.
                _focusKey = null;
                await JS.InvokeVoidAsync("upms.focusByIdIfLost", LinkId(key));
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private string AddressOf(ListState state) => Key + "?" + string.Join('&', state.ToParameters().Select(p => $"{p.Key}={p.Value}"));

    private async Task LoadAsync()
    {
        var address = _loadedAddress;
        var query = State.ToQuery();
        _today = await ViewerToday.GetAsync();
        var result = await Lists.ListAsync(Key, query, _today, CancellationToken.None);
        // The epics or stages for the filter; a new one may have been created since the last load.
        IReadOnlyList<ContainerOption> containers = [];
        if (result.IsSuccess && await Items.ListContainersAsync(Key, CancellationToken.None) is { IsSuccess: true } listed)
        {
            containers = listed.Value!;
        }

        if (address != _loadedAddress)
        {
            return; // the answer for an older address, which arrived after a newer one was asked for
        }

        _containers = containers;

        if (!result.IsSuccess)
        {
            // Someone removed from the team meanwhile sees what they may see now: "not found" (Phase 2 FR-011).
            _view = null;
            _notFound = result.Error!.Kind is ErrorKind.NotFound or ErrorKind.Forbidden;
            _error = _notFound ? null : result.Error.Message;
            return;
        }

        _notFound = false;
        _view = result.Value!;
        _selected.IntersectWith(_view.Rows.Items.Select(r => r.Key));
    }

    private void Go(ListState state)
    {
        _requested = state;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(state.ToParameters()));
    }

    /// <summary>Searches as the person types, a moment after they stop, as Jira's list does; Enter searches at once.</summary>
    private async Task SearchTypedAsync(ChangeEventArgs e)
    {
        _textDraft = e.Value?.ToString() ?? "";
        _typing?.Cancel();
        var typing = _typing = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, typing.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (Latest.Text != _textDraft.Trim())
        {
            Go(Latest.WithText(_textDraft));
        }
    }

    private void SearchNow()
    {
        _typing?.Cancel();
        Go(Latest.WithText(_textDraft));
    }

    private void AddLabelFilter()
    {
        var label = _labelDraft.Trim();
        _labelDraft = "";
        if (label.Length > 0 && !Latest.Labels.Contains(label, StringComparer.OrdinalIgnoreCase))
        {
            Go(Latest.ToggleLabel(label));
        }
    }

    private void ClearFilters()
    {
        _panel = Panel.None;
        _textDraft = "";
        Go(Latest.WithoutFilters());
    }

    private void ResetSort()
    {
        _panel = Panel.None;
        Go(Latest with { Sort = ListState.Default.Sort, Descending = ListState.Default.Descending, Page = 1 });
    }

    private void Toggle(Panel panel) => _panel = _panel == panel ? Panel.None : panel;

    private void PanelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _panel = Panel.None;
        }
    }

    private void SetGroup(ListGroup group)
    {
        _panel = Panel.None;
        _collapsed.Clear();
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("group", group == ListGroup.None ? null : group.ToString().ToLowerInvariant()));
    }

    private void ToggleGroup(string id)
    {
        if (!_collapsed.Remove(id))
        {
            _collapsed.Add(id);
        }
    }

    private async Task ToggleColumnAsync(string id)
    {
        if (!_columns.Remove(id))
        {
            _columns.Add(id);
        }

        await SaveColumnsAsync();
    }

    private async Task ResetColumnsAsync()
    {
        _panel = Panel.None;
        _columns = AllColumns.Where(c => c.ShownByDefault).Select(c => c.Id).ToHashSet();
        await SaveColumnsAsync();
    }

    private async Task SaveColumnsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("upms.store.set", ColumnsKey, string.Join(',', _columns));
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void ToggleAll()
    {
        if (AllSelected)
        {
            _selected.Clear();
        }
        else
        {
            _selected.UnionWith(_view!.Rows.Items.Select(r => r.Key));
        }
    }

    private void ToggleRow(string key)
    {
        if (!_selected.Remove(key))
        {
            _selected.Add(key);
        }
    }

    /// <summary>The page's rows under one heading per value of the grouping, in the order Jira shows them.</summary>
    private IEnumerable<RowGroup> Groups()
    {
        var rows = _view!.Rows.Items;
        if (Group == ListGroup.None || rows.Count == 0)
        {
            return rows.Count == 0 ? [] : [new RowGroup("all", rows.ToList())];
        }

        var columnOrder = _view.Columns.Select((c, i) => (c.Id, i)).ToDictionary(c => c.Id, c => c.i);
        var kindOrder = FilterKinds.Select((k, i) => (k, i)).ToDictionary(k => k.k, k => k.i);
        return Group switch
        {
            ListGroup.Status => rows.GroupBy(r => r.Status.Id).OrderBy(g => columnOrder.GetValueOrDefault(g.Key))
                .Select(g => new RowGroup($"s{g.Key}", g.ToList())),
            ListGroup.Priority => rows.GroupBy(r => r.Priority).OrderBy(g => g.Key).Select(g => new RowGroup($"p{g.Key}", g.ToList())),
            ListGroup.Assignee => rows.GroupBy(r => r.Assignee?.UserId)
                .OrderBy(g => g.Key is null).ThenBy(g => g.First().Assignee?.DisplayName, StringComparer.CurrentCultureIgnoreCase)
                .Select(g => new RowGroup($"a{g.Key}", g.ToList())),
            ListGroup.Epic => rows.GroupBy(r => r.Container?.Key)
                .OrderBy(g => g.Key is null).ThenBy(g => g.Key, StringComparer.Ordinal)
                .Select(g => new RowGroup($"e{g.Key}", g.ToList())),
            _ => rows.GroupBy(r => r.Type).OrderBy(g => kindOrder.GetValueOrDefault(g.Key, 99)).Select(g => new RowGroup($"t{g.Key}", g.ToList())),
        };
    }

    /// <summary>A group's heading, drawn from its first row.</summary>
    private RenderFragment GroupHead(WorkItemRow row) => __builder =>
    {
        switch (Group)
        {
            case ListGroup.Status:
                <span class="lozenge-status st-@CategoryClass(row.Status.Category)" title="@row.Status.Name">@row.Status.Name</span>
                break;
            case ListGroup.Priority:
                <span class="group-name"><PriorityIcon Priority="row.Priority" /> @row.Priority</span>
                break;
            case ListGroup.Assignee:
                @Person(row.Assignee, "Unassigned")
                break;
            case ListGroup.Epic:
                @if (row.Container is { } container)
                {
                    <EpicTag Container="container" ShowKey="true" />
                }
                else
                {
                    <span class="group-name">No @ContainerLabel.ToLowerInvariant()</span>
                }
                break;
            default:
                <span class="group-name"><TypeIcon Type="row.Type" /> @WorkItemTypes.DisplayName(row.Type)</span>
                break;
        }
    };

    private RenderFragment HeaderCell(string id, string label, ListSort? sort, string cssClass) => __builder =>
    {
        if (sort is { } by)
        {
            <th scope="col" class="@cssClass" data-sort="@ListState.NameOf(by)" aria-sort="@AriaSort(by)">
                <button type="button" class="sort-btn" @onclick="() => Go(Latest.WithSort(by))">
                    @label
                    @if (State.Sort == by)
                    {
                        <span class="sort-arrow" aria-hidden="true">@(State.Descending ? "↓" : "↑")</span>
                    }
                </button>
            </th>
        }
        else
        {
            <th scope="col" class="@cssClass">@label</th>
        }
    };

    private RenderFragment RowView(WorkItemRow row) => __builder =>
    {
        var selected = _selected.Contains(row.Key);
        <tr data-testid="list-row" data-key="@row.Key" class="@(selected ? "is-selected" : "")" @key="row.Key">
            <td class="col-check"><input type="checkbox" aria-label="Select @row.Key" checked="@selected" @onchange="() => ToggleRow(row.Key)" /></td>
            <td class="col-work">
                <span class="work-cell">
                    <TypeIcon Type="row.Type" />
                    <a id="@LinkId(row.Key)" class="task-link work-link" href="@TaskHref(row.Key)"><span class="work-key">@row.Key</span> <span class="work-title">@row.Title</span></a>
                    @if (row.ParentKey is { } parent)
                    {
                        <span class="work-parent">in @parent</span>
                    }
                </span>
            </td>
            @foreach (var column in VisibleColumns)
            {
                <td class="col-@column.Id">@Cell(column.Id, row)</td>
            }
            <td class="col-pick"></td>
        </tr>
    };

    private RenderFragment Cell(string id, WorkItemRow row) => __builder =>
    {
        switch (id)
        {
            case "assignee":
                @Person(row.Assignee, "Unassigned")
                break;
            case "reporter":
                @Person(row.Reporter, "Unknown")
                break;
            case "priority":
                <span class="cell-flex"><PriorityIcon Priority="row.Priority" /> <span aria-hidden="true">@row.Priority</span></span>
                break;
            case "status":
                @if (_view!.CanContribute)
                {
                    <select class="list-status st-@CategoryClass(row.Status.Category)" aria-label="Status of @row.Key" disabled="@_busy"
                            @onchange="e => StatusChangedAsync(row, e)">
                        @foreach (var column in _view.Columns)
                        {
                            <option value="@column.Id" selected="@(column.Id == row.Status.Id)">@column.Name</option>
                        }
                    </select>
                }
                else
                {
                    <span class="lozenge-status st-@CategoryClass(row.Status.Category)" title="@row.Status.Name">@row.Status.Name</span>
                }
                break;
            case "resolution":
                @(row.ResolvedAt is null ? "Unresolved" : "Done")
                break;
            case "created":
                <LocalTime Value="row.CreatedAt" Format="d MMM yyyy, HH:mm" />
                break;
            case "updated":
                <LocalTime Value="row.UpdatedAt" Format="d MMM yyyy, HH:mm" />
                break;
            case "due":
                <DueDateText Due="row.DueDate" IsOpen="row.IsOpen" Today="_today" WithYear="true" />
                break;
            case "start":
                @DateText(row.StartDate)
                break;
            case "parent":
                <EpicTag Container="row.Container" ShowKey="true" />
                break;
            case "labels":
                @if (row.Labels.Count > 0)
                {
                    <ul class="card-labels">
                        @foreach (var label in row.Labels)
                        {
                            <li class="label-chip">@label</li>
                        }
                    </ul>
                }
                break;
            case var field when field.StartsWith(FieldColumnPrefix, StringComparison.Ordinal):
                @* A space field's value in words (live test, 2026-10-28). *@
                @(long.TryParse(field[FieldColumnPrefix.Length..], out var fieldId) && row.FieldText.TryGetValue(fieldId, out var text) ? text : "")
                break;
            default:
                <span class="cell-flex"><TypeIcon Type="row.Type" /> @WorkItemTypes.DisplayName(row.Type)</span>
                break;
        }
    };

    private static RenderFragment Person(AssigneeRef? person, string none) => __builder =>
    {
        <span class="cell-flex">
            @if (person is { } who)
            {
                <Avatar UserId="who.UserId" Initials="@who.Initials" />
                <span class="cell-text">@who.DisplayName</span>
            }
            else
            {
                <span class="avatar avatar-unassigned" aria-hidden="true"><Icon Name="person" Size="12" /></span>
                <span class="cell-text">@none</span>
            }
        </span>
    };

    /// <summary>Moves one item from its Status cell, with the same rules as the board and the drawer; saves run one at a
    /// time.</summary>
    private async Task StatusChangedAsync(WorkItemRow row, ChangeEventArgs e)
    {
        if (_busy || !long.TryParse(e.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out var id) || id == row.Status.Id)
        {
            return;
        }

        _busy = true;
        try
        {
            var saved = await Items.UpdateAsync(row.Key, new WorkItemEdit.Status(id), row.Version, CancellationToken.None);
            if (saved.IsSuccess)
            {
                Announcer.Announce($"{row.Key} moved to {_view!.Columns.First(c => c.Id == id).Name}.");
            }
            else
            {
                _error = saved.Error!.Kind == ErrorKind.Conflict
                    ? $"{row.Key} was changed by someone else. The list now shows the latest."
                    : $"{row.Key}: {saved.Error.Message}";
            }

            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private Task BulkStatusAsync(ChangeEventArgs e) =>
        long.TryParse(e.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out var id)
            ? BulkAsync(new WorkItemEdit.Status(id), $"moved to {_view!.Columns.First(c => c.Id == id).Name}")
            : Task.CompletedTask;

    private Task BulkPriorityAsync(ChangeEventArgs e) =>
        Enum.TryParse<Priority>(e.Value?.ToString(), out var priority)
            ? BulkAsync(new WorkItemEdit.Priority(priority), $"set to {priority} priority")
            : Task.CompletedTask;

    private Task BulkAssignAsync(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";
        if (value == ListState.UnassignedValue)
        {
            return BulkAsync(new WorkItemEdit.Assignee(null), "unassigned");
        }

        return Guid.TryParse(value, out var id)
            ? BulkAsync(new WorkItemEdit.Assignee(id), $"assigned to {_view!.People.First(p => p.UserId == id).DisplayName}")
            : Task.CompletedTask;
    }

    private DeleteWorkItemsDialog? _deleteDialog;

    /// <summary>Jira's "Delete" for the selected items: asks first, listing any the person cannot delete.</summary>
    private Task AskDeleteAsync()
    {
        _error = null;
        return _deleteDialog!.AskAsync(_view!.Rows.Items.Where(r => _selected.Contains(r.Key)).Select(r => r.Key).ToList());
    }

    private async Task DeletedAsync()
    {
        _selected.Clear();
        await LoadAsync();
    }

    /// <summary>Applies one change to every selected item, one save at a time, then says how many it changed.</summary>
    private async Task BulkAsync(WorkItemEdit edit, string what)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var rows = _view!.Rows.Items.Where(r => _selected.Contains(r.Key)).ToList();
            var failed = new List<string>();
            foreach (var row in rows)
            {
                var saved = await Items.UpdateAsync(row.Key, edit, row.Version, CancellationToken.None);
                if (!saved.IsSuccess)
                {
                    failed.Add($"{row.Key}: {saved.Error!.Message}");
                }
            }

            var changed = rows.Count - failed.Count;
            Announcer.Announce($"{changed} {(changed == 1 ? "work item" : "work items")} {what}.");
            _error = failed.Count == 0 ? null : string.Join(" ", failed);
            _selected.Clear();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private string TaskHref(string key) => Navigation.ToBaseRelativePath(Navigation.GetUriWithQueryParameter("task", key));

    private static string LinkId(string key) => $"list-task-{key}";

    private void CloseDrawer()
    {
        _focusKey = TaskKey;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("task", (string?)null));
    }

    private async Task<string?> CreateAsync(string title, WorkItemType type)
    {
        var result = await Items.CreateAsync(Key, new NewWorkItem(type, title), CancellationToken.None);
        if (result.Error is { Kind: ErrorKind.NotFound or ErrorKind.Forbidden })
        {
            await LoadAsync();
            StateHasChanged();
            return result.Error.Message;
        }

        if (!result.IsSuccess)
        {
            return result.Error!.MessageFor("Title");
        }

        Announcer.Announce($"Created {result.Value!.Key}: {result.Value.Title}.");
        await LoadAsync();
        // Called through a plain delegate from the input box, so re-render explicitly.
        StateHasChanged();
        return null;
    }

    private string AriaSort(ListSort sort) => sort != State.Sort ? "none" : State.Descending ? "descending" : "ascending";

    private string DateText(DateOnly? date) => date is { } d ? d.ToString("d MMM yyyy", CultureInfo.InvariantCulture) : "";

    private static string CategoryClass(StatusCategory category) => category switch
    {
        StatusCategory.Done => "done",
        StatusCategory.InProgress => "inprogress",
        _ => "todo",
    };

    private string GroupLabel(ListGroup group) => group switch
    {
        ListGroup.Epic => ContainerLabel,
        ListGroup.Type => "Work type",
        _ => group.ToString(),
    };

    private static string DueLabel(DueFilter due) => due switch
    {
        DueFilter.Overdue => "Overdue",
        DueFilter.Next7Days => "Due in the next 7 days",
        _ => "No due date",
    };

    // An item made with the Create form in this space shows at once (Jira parity pass FR-001).
    private void OnCreated(string spaceKey, string itemKey)
    {
        if (string.Equals(spaceKey, Key, StringComparison.OrdinalIgnoreCase))
        {
            _ = InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        _typing?.Cancel();
        Launcher.Created -= OnCreated;
    }
}
