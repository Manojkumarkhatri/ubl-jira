<div class="inline-create">
    <label class="sr-only" for="@_id">What needs to be done? New task in @ColumnName</label>
    <input id="@_id" class="input inline-input" type="text" placeholder="What needs to be done?" autocomplete="off"
           @ref="_input" @bind="_text" @bind:event="oninput" @onkeydown="OnKeyDownAsync"
           aria-invalid="@(_error is null ? "false" : "true")" aria-describedby="@(_id)-error" />
    @if (_error is not null)
    {
        <span id="@(_id)-error" class="error-text" role="alert">@_error</span>
    }
</div>

@code {
    private readonly string _id = "new-task-" + Guid.NewGuid().ToString("N")[..8];
    private ElementReference _input;
    private string _text = "";
    private string? _error;
    private bool _busy;

    [Parameter, EditorRequired]
    public string ColumnName { get; set; } = "";

    /// <summary>Creates the task; returns an error message, or null when the task was created.</summary>
    [Parameter, EditorRequired]
    public Func<string, Task<string?>> OnCreate { get; set; } = default!;

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _text = "";
            _error = null;
            return;
        }

        if (e.Key != "Enter" || _busy)
        {
            return;
        }

        var title = _text.Trim();
        if (title.Length == 0)
        {
            return; // An empty box creates nothing (FR-018).
        }

        _busy = true;
        try
        {
            _error = await OnCreate(title);
            if (_error is null)
            {
                _text = "";
                await _input.FocusAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
