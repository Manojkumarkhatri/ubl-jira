@page "/projects/{Key}/board"
@using Upms.Application.Work
@using Upms.Web.Components.Pages.Drawer
@inject IBoardService Boards
@inject ViewerToday ViewerToday
@inject LiveAnnouncer Announcer
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(_board?.ProjectName ?? Key) · Board · U-PMS</PageTitle>

@if (_notFound)
{
    <NotFoundContent />
}
else if (_board is null)
{
    <p aria-busy="true">Loading the board…</p>
}
else
{
    <ProjectHeader ProjectKey="@_board.ProjectKey" Title="@_board.ProjectName" Current="ProjectPage.Board"
                   CanManage="_board.CanManageColumns" CanRestoreDeleted="_board.CanRestoreDeleted">
        @if (_board.ShowingAllDone)
        {
            <a class="btn" href="projects/@Key/board">Show recently completed only</a>
        }
        else if (_board.HiddenDoneCount > 0)
        {
            <a class="btn" href="projects/@Key/board?done=all">Show all completed (@_board.HiddenDoneCount more)</a>
        }
    </ProjectHeader>

    @if (_conflict is not null)
    {
        <div class="alert alert-warn" role="alert" data-testid="conflict">
            @_conflict
            <button type="button" class="btn btn-sm btn-ghost" @onclick="() => _conflict = null">Dismiss</button>
        </div>
    }
    @if (_error is not null)
    {
        <div class="alert alert-error" role="alert">@_error</div>
    }
    @foreach (var warning in _warnings)
    {
        <div class="alert alert-warn" role="status">@warning</div>
    }

    @* Filters run over the cards already shown, so they apply at once (Phase 2 FR-022, research R10). *@
    <div class="board-filters" role="group" aria-label="Filter cards">
        <button type="button" class="btn btn-sm @(IsOnlyMine ? "active" : "")" aria-pressed="@(IsOnlyMine ? "true" : "false")"
                data-testid="only-mine" @onclick="ToggleOnlyMine">Only my tasks</button>
        <label for="assignee-filter">Assignee</label>
        <select id="assignee-filter" class="select select-sm" value="@_assigneeFilter" @onchange="AssigneeFilterChanged">
            <option value="">Anyone</option>
            <option value="@MeFilter">@(MyName is { } name ? $"Me ({name})" : "Me")</option>
            <option value="@UnassignedFilter">Unassigned</option>
            @foreach (var person in _people)
            {
                <option value="@person.UserId">@person.DisplayName</option>
            }
        </select>
    </div>

    <div class="board-wrap" role="region" aria-label="Board" tabindex="0">
        <div class="board">
            @foreach (var column in _board.Columns)
            {
                <BoardColumn @key="column.Id" Column="column" ProjectKey="@Key" ShowAllDone="_board.ShowingAllDone" MoveTargets="_moveTargets" DraggingKey="@_dragging?.Key"
                             CanContribute="_board.CanContribute" Filter="CardFilter" Today="_today"
                             OnDragStart="card => _dragging = card" OnDragEnd="() => _dragging = null"
                             OnDropBefore="DropBeforeAsync" OnDropAtEnd="DropAtEndAsync" OnMove="MoveFromMenuAsync"
                             OnCreate="CreateAsync" />
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(TaskKey))
    {
        <TaskDrawer WorkItemKey="@TaskKey" OnClose="CloseDrawer" OnChanged="LoadAsync" />
    }
}

@code {
    private const string MeFilter = "me";
    private const string UnassignedFilter = "unassigned";
    private BoardView? _board;
    private DateOnly _today;
    private string _assigneeFilter = "";
    private IReadOnlyList<AssigneeRef> _people = [];
    private bool _notFound;
    private string? _conflict;
    private string? _error;
    private IReadOnlyList<string> _warnings = [];
    private CardView? _dragging;
    private IReadOnlyList<ColumnOption> _moveTargets = [];
    private (string Key, string? Done)? _loaded;
    private string? _focusCardKey;

    [Parameter]
    public string Key { get; set; } = "";

    /// <summary><c>?done=all</c> shows every completed task (FR-021).</summary>
    [SupplyParameterFromQuery(Name = "done")]
    public string? Done { get; set; }

    /// <summary><c>?task={KEY-N}</c> opens that task's details drawer over the board (FR-023).</summary>
    [SupplyParameterFromQuery(Name = "task")]
    public string? TaskKey { get; set; }

    // Opening or closing the drawer changes only the query string: the board is not loaded again.
    protected override Task OnParametersSetAsync() =>
        _loaded == (Key, Done) ? Task.CompletedTask : LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusCardKey is { } key && string.IsNullOrEmpty(TaskKey))
        {
            // Focus returns to the card whose drawer was closed or that was just moved, wherever it is now.
            _focusCardKey = null;
            try
            {
                await JS.InvokeVoidAsync("upms.focusById", $"card-{key}-title");
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private async Task LoadAsync()
    {
        _loaded = (Key, Done);
        var result = await Boards.GetAsync(Key, Done == "all", CancellationToken.None);
        if (!result.IsSuccess)
        {
            _board = null;
            _notFound = result.Error!.Kind is ErrorKind.NotFound or ErrorKind.Forbidden;
            _error = _notFound ? null : result.Error.Message;
            return;
        }

        _notFound = false;
        _board = result.Value!;
        _today = await ViewerToday.GetAsync();
        _moveTargets = _board.Columns.Select(c => new ColumnOption(c.Id, c.Name)).ToList();
        // Everyone the cards are assigned to, apart from the viewer (offered as "Me").
        _people = _board.Columns.SelectMany(c => c.Cards)
            .Select(c => c.Assignee)
            .OfType<AssigneeRef>()
            .Where(a => a.UserId != _board.ViewerId)
            .DistinctBy(a => a.UserId)
            .OrderBy(a => a.DisplayName, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }

    private bool IsOnlyMine => _assigneeFilter == MeFilter;

    private string? MyName => _board?.Columns.SelectMany(c => c.Cards)
        .Select(c => c.Assignee)
        .FirstOrDefault(a => a?.UserId == _board.ViewerId)?.DisplayName;

    /// <summary>"Only my tasks" is a shortcut for the assignee filter's "Me".</summary>
    private Func<CardView, bool>? CardFilter => _assigneeFilter switch
    {
        MeFilter => card => card.Assignee?.UserId == _board!.ViewerId,
        UnassignedFilter => card => card.Assignee is null,
        var id when Guid.TryParse(id, out var userId) => card => card.Assignee?.UserId == userId,
        _ => null,
    };

    private void ToggleOnlyMine() => ApplyFilter(IsOnlyMine ? "" : MeFilter);

    private void AssigneeFilterChanged(ChangeEventArgs e) => ApplyFilter(e.Value?.ToString() ?? "");

    private void ApplyFilter(string filter)
    {
        _assigneeFilter = filter;
        var cards = _board?.Columns.SelectMany(c => c.Cards).ToList() ?? [];
        Announcer.Announce(CardFilter is { } matches
            ? $"Showing {cards.Count(matches)} of {cards.Count} cards."
            : $"Showing all {cards.Count} cards.");
    }

    private void CloseDrawer()
    {
        _focusCardKey = TaskKey;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("task", (string?)null));
    }

    private async Task DropBeforeAsync(CardView target)
    {
        var dragged = _dragging;
        _dragging = null;
        if (dragged is not null && dragged.Key != target.Key)
        {
            await MoveAsync(dragged, target.ColumnId, new CardPlacement.Before(target.Key));
        }
    }

    private async Task DropAtEndAsync(ColumnView column)
    {
        var dragged = _dragging;
        _dragging = null;
        if (dragged is not null)
        {
            await MoveAsync(dragged, column.Id, CardPlacement.AtEnd);
        }
    }

    // The keyboard "Move to" menu issues the same call as a drop (FR-019); focus follows the card to its new place.
    private async Task MoveFromMenuAsync((CardView Card, MoveRequest Request) move)
    {
        await MoveAsync(move.Card, move.Request.ColumnId, move.Request.Placement);
        _focusCardKey = move.Card.Key;
    }

    private async Task MoveAsync(CardView card, long columnId, CardPlacement placement)
    {
        _error = null;
        var result = await Boards.MoveCardAsync(card.Key, columnId, placement, card.Version, CancellationToken.None);
        if (result.IsSuccess)
        {
            _conflict = null;
            _warnings = result.Warnings;
            var column = _board?.Columns.FirstOrDefault(c => c.Id == columnId)?.Name ?? "the column";
            Announcer.Announce(placement switch
            {
                CardPlacement.Top => $"Moved {card.Key} to the top of {column}.",
                CardPlacement.Before before => $"Moved {card.Key} above {before.WorkItemKey} in {column}.",
                _ => $"Moved {card.Key} to {column}.",
            });
        }
        else if (result.Error!.Kind == ErrorKind.Conflict)
        {
            _conflict = result.Error.Message;
            Announcer.Announce(result.Error.Message);
        }
        else
        {
            _error = result.Error.Message;
        }

        await LoadAsync();
    }

    private async Task<string?> CreateAsync(long columnId, string title)
    {
        var result = await Boards.CreateInlineAsync(Key, columnId, title, CancellationToken.None);
        if (result.Error is { Kind: ErrorKind.NotFound or ErrorKind.Forbidden })
        {
            // The caller was removed from the project or made a Viewer meanwhile (Phase 2 FR-011): show what they may
            // see now, which is "not found" for someone no longer on the team.
            await LoadAsync();
            StateHasChanged();
            return result.Error.Message;
        }

        if (!result.IsSuccess)
        {
            return result.Error!.FieldErrors is { } errors && errors.TryGetValue("Title", out var messages)
                ? string.Join(" ", messages)
                : result.Error.Message;
        }

        Announcer.Announce($"Created {result.Value!.Key}: {result.Value.Title}.");
        await LoadAsync();
        // Called through a plain delegate from the column's input box, so re-render explicitly.
        StateHasChanged();
        return null;
    }
}
