@page "/admin/users"
@page "/admin/rights"
@inject IUserAdminService Admin
@inject IOrganizationAdminService Organization
@inject ICurrentUser Me
@inject NavigationManager Navigation

<PageTitle>User management · U-PMS</PageTitle>

@* One page for people and their rights (owner, 2026-10-26), as Jira's user management: the Users tab lists people, a
   double-click opens one person's type and rights; Admins also set each type's default rights. Admins manage everyone;
   others, with the rights for it, the people below their own type in their department. *@
<div class="page-head">
    <div>
        <div class="crumbs">Administration</div>
        <h1>User management</h1>
    </div>
    <span class="spacer"></span>
    @if (_rights?.CanAdd == true && !ShowingTypes)
    {
        <button type="button" class="btn btn-primary" data-testid="add-user" @onclick="() => _addDialog!.Open()"><Icon Name="plus" Size="16" /> Add user</button>
    }
</div>

@if (_rights is null)
{
    <p aria-busy="true">Loading…</p>
}
else if (!_rights.CanList)
{
    <EmptyState Title="Not available" Text="Only Admins, and people given the rights to manage users, open User management." />
}
else
{
    <nav class="settings-tabs" aria-label="User management">
        <a href="admin/users" aria-current="@(ShowingTypes ? null : "page")"><Icon Name="people" Size="16" /> Users</a>
        @if (_rights.IsAdministrator)
        {
            <a href="admin/rights" aria-current="@(ShowingTypes ? "page" : null)"><Icon Name="sliders" Size="16" /> Default rights by type</a>
        }
    </nav>

    @if (ShowingTypes && _rights.IsAdministrator)
    {
        <TypeRightsTab OnSaved="TypeRightsSavedAsync" />
    }
    else
    {
        @if (!_rights.IsAdministrator)
        {
            <p class="hint">
                You manage the people of @DepartmentName(_rights.DepartmentId) below @_rights.Type.DisplayName().
                @if (_rights.Types.Count > 0)
                {
                    @($" You can add: {string.Join(", ", _rights.Types.Select(t => t.DisplayName()))}.")
                }
            </p>
        }

        <div class="um-filters" role="group" aria-label="Show users of a type">
            <button type="button" class="um-chip @(_type is null ? "is-on" : "")" aria-pressed="@(_type is null ? "true" : "false")"
                    @onclick="() => FilterTypeAsync(null)">All <span class="um-chip-count">@_counts.Values.Sum().ToString("N0", System.Globalization.CultureInfo.CurrentCulture)</span></button>
            @foreach (var type in UserTypes.Ordered)
            {
                <button type="button" class="um-chip um-chip-@type.CssName() @(_type == type ? "is-on" : "")" aria-pressed="@(_type == type ? "true" : "false")"
                        @onclick="() => FilterTypeAsync(type)">@type.DisplayName() <span class="um-chip-count">@_counts.GetValueOrDefault(type).ToString("N0", System.Globalization.CultureInfo.CurrentCulture)</span></button>
            }
        </div>

        <div class="toolbar um-toolbar">
            <div class="um-search">
                <Icon Name="search" Size="16" />
                <label for="user-search" class="sr-only">Search users</label>
                <input id="user-search" type="search" class="input" placeholder="Search by name, user name or email"
                       @bind="_search" @bind:event="oninput" @bind:after="SearchAsync" />
            </div>
            <label for="user-status" class="sr-only">Status</label>
            <select id="user-status" class="select um-status" value="@StatusValue" @onchange="StatusChangedAsync">
                <option value="">All statuses</option>
                <option value="active">Active</option>
                <option value="deactivated">Deactivated</option>
            </select>
            <span class="spacer"></span>
            <span class="hint um-tip"><Icon Name="info" Size="14" /> Double-click a user to open their rights.</span>
        </div>

        @if (_page is null)
        {
            <p aria-busy="true">Loading…</p>
        }
        else if (_page.Items.Count == 0)
        {
            <EmptyState Title="No users found" Text="Try another search or type." />
        }
        else
        {
            <div class="table-wrap">
                <table class="tbl people-table" data-testid="users-table">
                    <caption class="sr-only">Users, page @_page.PageNumber of @Math.Max(1, _page.PageCount)</caption>
                    <thead>
                        <tr>
                            <th scope="col">User</th>
                            <th scope="col">Type</th>
                            <th scope="col" class="hide-sm">Department</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="hide-sm">Last sign-in</th>
                            <th scope="col"><span class="sr-only">Open</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in _page.Items)
                        {
                            <tr @key="user.Id" class="um-row" data-user="@user.UserName" title="Double-click to open @user.DisplayName"
                                @ondblclick="() => Open(user)">
                                <td>
                                    <div class="person-cell">
                                        <Avatar UserId="user.Id" Initials="@Initials(user.DisplayName)" />
                                        <span class="um-person">
                                            <span class="um-name-line">
                                                <button type="button" class="um-name" @onclick="() => Open(user)">@user.DisplayName</button>
                                                @if (user.Id == Me.UserId)
                                                {
                                                    @* An expression, so the leading space survives Razor's whitespace trimming. *@
                                                    <span class="muted">@(" (you)")</span>
                                                }
                                            </span>
                                            <span class="um-meta" title="@user.UserName · @user.Email">@user.UserName · @user.Email</span>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <UserTypeBadge Type="user.Type" />
                                    @if (HasOwnRights(user))
                                    {
                                        <span class="um-custom" title="Rights added or removed for this person">Own rights</span>
                                    }
                                </td>
                                <td class="hide-sm"><span class="um-dept" title="@user.Department">@(user.Department ?? "—")</span></td>
                                <td>
                                    @if (!user.IsActive)
                                    {
                                        <span class="lozenge lozenge-off">Deactivated</span>
                                    }
                                    else if (user.IsLockedOut)
                                    {
                                        <span class="lozenge lozenge-warn">Locked</span>
                                    }
                                    else
                                    {
                                        <span class="lozenge lozenge-ok">Active</span>
                                    }
                                </td>
                                <td class="hide-sm um-when">
                                    @if (user.LastSignInAt is { } lastSignIn)
                                    {
                                        <LocalTime Value="lastSignIn" />
                                    }
                                    else
                                    {
                                        <span class="muted">Never</span>
                                    }
                                </td>
                                <td class="um-open">
                                    <button type="button" class="icon-btn" aria-label="Open @user.DisplayName" @onclick="() => Open(user)">
                                        <Icon Name="chevron-right" Size="16" />
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager PageNumber="_page.PageNumber" PageCount="_page.PageCount" Label="User pages" OnPageChanged="GoToPageAsync" />
        }

        <AddUserDialog @ref="_addDialog" Caller="_rights" Departments="_departments" OnCreated="CreatedAsync" OnOpenRights="OpenCreatedAsync" />
        <UserPanel @ref="_panel" Caller="_rights" TypeRights="_typeRights" Departments="_departments" OnChanged="ReloadAsync" />
    }
}

@code {
    private PeopleRights? _rights;
    private IReadOnlyList<DepartmentInfo> _departments = [];
    private IReadOnlyDictionary<UserType, Rights> _typeRights = new Dictionary<UserType, Rights>();
    private IReadOnlyDictionary<UserType, int> _counts = new Dictionary<UserType, int>();
    private Page<UserSummary>? _page;
    private string _search = "";
    private UserType? _type;
    private bool? _active;
    private int _pageNumber = 1;
    private int _loads;
    private AddUserDialog? _addDialog;
    private UserPanel? _panel;

    private bool ShowingTypes => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("admin/rights", StringComparison.OrdinalIgnoreCase);

    private string StatusValue => _active switch
    {
        true => "active",
        false => "deactivated",
        _ => "",
    };

    protected override async Task OnInitializedAsync()
    {
        _rights = await Admin.RightsAsync(CancellationToken.None);
        if (!_rights.CanList)
        {
            return;
        }

        _departments = await Organization.DepartmentsAsync(CancellationToken.None);
        _typeRights = await Organization.TypeRightsAsync(CancellationToken.None);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _counts = await Admin.TypeCountsAsync(CancellationToken.None);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Searches overlap while someone types: only the answer to the latest one is shown.
        var load = ++_loads;
        var result = await Admin.FindUsersAsync(new UserQuery(_search, _type, _active), new PageRequest(_pageNumber), CancellationToken.None);
        if (load == _loads)
        {
            _page = result.Value ?? Page<UserSummary>.Empty(PageRequest.First);
        }
    }

    private async Task SearchAsync()
    {
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task FilterTypeAsync(UserType? type)
    {
        _type = type;
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task StatusChangedAsync(ChangeEventArgs e)
    {
        _active = e.Value?.ToString() switch
        {
            "active" => true,
            "deactivated" => false,
            _ => null,
        };
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _pageNumber = page;
        await LoadAsync();
    }

    private void Open(UserSummary user) => _panel?.Open(user);

    private async Task CreatedAsync(CreatedUser created) => await ReloadAsync();

    /// <summary>"Open their rights" after adding: finds the new person and opens them.</summary>
    private async Task OpenCreatedAsync(CreatedUser created)
    {
        var found = await Admin.FindUsersAsync(new UserQuery(created.UserName), PageRequest.First, CancellationToken.None);
        if (found.Value?.Items.FirstOrDefault(u => u.Id == created.Id) is { } user)
        {
            Open(user);
        }
    }

    private async Task TypeRightsSavedAsync() => _typeRights = await Organization.TypeRightsAsync(CancellationToken.None);

    private string DepartmentName(long? id) => _departments.FirstOrDefault(d => d.Id == id)?.Name ?? "your department";

    /// <summary>Rights added or removed for this person alone, within what their type can have.</summary>
    private static bool HasOwnRights(UserSummary user) =>
        user.Type != UserType.Admin && ((user.Granted | user.Denied) & RightsCatalog.Allowed(user.Type)) != Rights.None;

    private static string Initials(string name) => string.Concat(name
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));
}
