@* A 16 px line icon in Jira's style. Decorative: the control it sits in carries the words. *@
<svg class="ui-icon @Class" viewBox="0 0 16 16" width="@Size" height="@Size" aria-hidden="true" focusable="false" fill="none"
     stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
    @switch (Name)
    {
        case "summary":
            <circle cx="8" cy="8" r="6" /><path d="M2 8h12M8 2c2 1.8 2 10.2 0 12M8 2c-2 1.8-2 10.2 0 12" />
            break;
        case "board":
            <rect x="2" y="3" width="12" height="10" rx="1.5" /><path d="M6 3v10M10 3v10" />
            break;
        case "list":
            <rect x="2" y="3" width="12" height="10" rx="1.5" /><path d="M2 6.5h12M2 9.5h12M6 3v10" />
            break;
        case "timeline":
            <path d="M2.5 4h7M5 8h8.5M2.5 12h6" /><rect x="2" y="2.5" width="8" height="3" rx="1.5" /><rect x="4.5" y="6.5" width="9.5" height="3" rx="1.5" /><rect x="2" y="10.5" width="7" height="3" rx="1.5" />
            break;
        case "backlog":
            <path d="M3 4h10M3 8h10M3 12h6" />
            break;
        case "stages":
            <path d="M2 12l4-8 4 8 4-8" />
            break;
        case "person":
            <circle cx="8" cy="5.5" r="2.5" /><path d="M3 13.5c.8-2.6 2.7-4 5-4s4.2 1.4 5 4" />
            break;
        case "people":
            <circle cx="6" cy="5.5" r="2.2" /><path d="M1.8 13c.6-2.3 2.2-3.6 4.2-3.6s3.6 1.3 4.2 3.6" /><circle cx="11.2" cy="6" r="1.8" /><path d="M11 9.6c1.6 0 2.8 1 3.3 2.8" />
            break;
        case "search":
            <circle cx="7" cy="7" r="4.5" /><path d="M10.5 10.5L14 14" />
            break;
        case "filter":
            <path d="M2.5 4h11M4.5 8h7M6.5 12h3" />
            break;
        case "group":
            <path d="M8 2l6 3-6 3-6-3 6-3z" /><path d="M2 8l6 3 6-3M2 11l6 3 6-3" />
            break;
        case "more":
            <circle cx="3.5" cy="8" r=".9" fill="currentColor" /><circle cx="8" cy="8" r=".9" fill="currentColor" /><circle cx="12.5" cy="8" r=".9" fill="currentColor" />
            break;
        case "plus":
            <path d="M8 3v10M3 8h10" />
            break;
        case "lock":
            <rect x="3.5" y="7" width="9" height="7" rx="1.5" /><path d="M5.5 7V5a2.5 2.5 0 015 0v2" />
            break;
        case "check-square":
            <rect x="2.5" y="2.5" width="11" height="11" rx="2" /><path d="M5.5 8l2 2 3.5-4" />
            break;
        case "info":
            <circle cx="8" cy="8" r="6" fill="currentColor" stroke="none" /><path d="M8 7.3v3.7M8 5v.1" stroke="#fff" />
            break;
        case "arrow-left":
            <path d="M13 8H3M7 4L3 8l4 4" />
            break;
        case "chevron-down":
            <path d="M4 6l4 4 4-4" />
            break;
        case "home":
            <path d="M2.5 7.5 8 3l5.5 4.5" /><path d="M4 6.5V13h3V9.5h2V13h3V6.5" />
            break;
        case "foryou":
            <circle cx="8" cy="8" r="6" /><circle cx="8" cy="6.8" r="2" /><path d="M4.6 12.2c.8-1.6 2-2.4 3.4-2.4s2.6.8 3.4 2.4" />
            break;
        case "clock":
            <circle cx="8" cy="8" r="6" /><path d="M8 4.8V8l2.2 1.6" />
            break;
        case "star":
            <path d="M8 2.2l1.8 3.7 4 .6-2.9 2.8.7 4L8 11.4l-3.6 1.9.7-4-2.9-2.8 4-.6z" />
            break;
        case "spaces":
            <path d="M9.5 2.5c2.5.3 4 1.8 4 4.2L9 11.2 4.8 7l4.7-4.5z" /><path d="M6 8.2L3 9l1.5 1.5M7.8 10L7 13l-1.5-1.5" /><circle cx="10.2" cy="5.8" r=".9" />
            break;
        case "calendar":
            <rect x="2.5" y="3.5" width="11" height="10" rx="1.5" /><path d="M2.5 6.5h11M5.5 2v3M10.5 2v3" />
            break;
        case "attachments":
            <path d="M12.5 7.5l-4.8 4.8a3 3 0 01-4.2-4.2l5-5a2 2 0 012.8 2.8l-5 5a1 1 0 01-1.4-1.4L9.5 4.9" />
            break;
        case "reports":
            <path d="M2.5 13.5h11M4.5 11V8M7.5 11V4.5M10.5 11V6.5" stroke-width="1.6" />
            break;
        case "warning":
            <path d="M8 2.2L14.3 13.3H1.7z" fill="currentColor" stroke="none" /><path d="M8 6.5v3.2" stroke="#fff" stroke-width="1.6" /><circle cx="8" cy="11.4" r=".9" fill="#fff" stroke="none" />
            break;
        case "check-circle":
            <circle cx="8" cy="8" r="6" /><path d="M5.3 8.2l1.9 1.8 3.6-3.8" />
            break;
        case "pencil":
            <path d="M10.5 2.8l2.7 2.7-7.4 7.4-3.2.5.5-3.2zM9.2 4.1l2.7 2.7" />
            break;
        case "created":
            <rect x="2.5" y="2.5" width="11" height="11" rx="2" /><path d="M5.3 8.2l1.9 1.8 3.6-3.8" />
            break;
        case "approvals":
            <path d="M4 2.5v4.5M12 2.5v4.5M4 7c0 2.5 4 2.5 4 5.5M12 7c0 2.5-4 2.5-4 5.5M8 12.5V14" />
            break;
        case "forms":
            <path d="M3 3h10M3 6.5h6M3 10h10M3 13.5h6" />
            break;
        case "docs":
            <rect x="3" y="2" width="10" height="12" rx="1.5" /><path d="M5.5 5.5h5M5.5 8h5M5.5 10.5h3" />
            break;
        case "archived":
            <rect x="2" y="2.5" width="12" height="3" rx=".8" /><path d="M3 5.5v7a1 1 0 001 1h8a1 1 0 001-1v-7M6.5 8h3" />
            break;
        case "sliders":
            <path d="M2.5 5h6M11.5 5h2M2.5 11h2M7.5 11h6" /><circle cx="10" cy="5" r="1.5" /><circle cx="6" cy="11" r="1.5" />
            break;
        case "refresh":
            <path d="M13 8a5 5 0 01-8.7 3.3M3 8a5 5 0 018.7-3.3M11.7 2v2.7H9M4.3 14v-2.7H7" />
            break;
        case "share":
            <circle cx="11.5" cy="3.5" r="1.7" /><circle cx="4.5" cy="8" r="1.7" /><circle cx="11.5" cy="12.5" r="1.7" /><path d="M6 7l4-2.5M6 9l4 2.5" />
            break;
        case "download":
            <path d="M8 2.5v8M4.5 7.5L8 11l3.5-3.5M2.5 13.5h11" />
            break;
        case "shortcut":
            <path d="M9 2.5h4.5V7M13.5 2.5L7.5 8.5M11.5 9.5v3a1 1 0 01-1 1h-7a1 1 0 01-1-1v-7a1 1 0 011-1h3" />
            break;
        case "fullscreen":
            <path d="M2.5 6V2.5H6M10 2.5h3.5V6M13.5 10v3.5H10M6 13.5H2.5V10" />
            break;
        case "fullscreen-exit":
            <path d="M6 2.5V6H2.5M13.5 6H10V2.5M10 13.5V10h3.5M2.5 10H6v3.5" />
            break;
        case "tag":
            <path d="M2.5 8.2V3a.5.5 0 01.5-.5h5.2l5.3 5.3-5.7 5.7z" /><circle cx="5.5" cy="5.5" r="1" />
            break;
        case "expand":
            <path d="M9.5 2.5h4v4M13.5 2.5L9 7M6.5 13.5h-4v-4M2.5 13.5L7 9" />
            break;
        case "collapse":
            <path d="M13.5 6.5h-4v-4M9.5 6.5L14 2M2.5 9.5h4v4M6.5 9.5L2 14" />
            break;
        case "eye":
            <path d="M1.5 8s2.4-4.5 6.5-4.5S14.5 8 14.5 8 12.1 12.5 8 12.5 1.5 8 1.5 8z" /><circle cx="8" cy="8" r="2" />
            break;
        case "chevron-right":
            <path d="M6 4l4 4-4 4" />
            break;
        case "text":
            <path d="M2 12.5l3-9 3 9M3 9.5h4" /><path d="M13.5 8.5v4M13.5 10.5a2 2 0 1 1-4 0 2 2 0 0 1 4 0z" />
            break;
        case "paragraph":
            <path d="M2.5 4h11M2.5 7h11M2.5 10h11M2.5 13h7" />
            break;
        case "hash":
            <path d="M6 2.5l-1.5 11M11.5 2.5L10 13.5M3 6h10.5M2.5 10H13" />
            break;
        case "formula":
            <path d="M9.5 2.5C8 2.5 7.6 3.5 7.3 5l-1.6 8c-.3 1.4-.9 2-2.2 2M4.5 6.5h5" /><path d="M10 9l3.5 4.5M13.5 9L10 13.5" />
            break;
        case "dropdown":
            <rect x="2" y="4" width="12" height="8" rx="1.5" /><path d="M9.5 7l1.5 1.5L12.5 7" />
            break;
        case "priority":
            <path d="M5 13.5v-11M2.5 5L5 2.5 7.5 5M11 2.5v11M8.5 11l2.5 2.5 2.5-2.5" />
            break;
        case "timer":
            <circle cx="8" cy="9" r="5" /><path d="M8 9V6.5M6.5 1.5h3M12 4.5l1-1" />
            break;
        case "grip":
            <circle cx="6" cy="4" r=".6" /><circle cx="10" cy="4" r=".6" /><circle cx="6" cy="8" r=".6" /><circle cx="10" cy="8" r=".6" /><circle cx="6" cy="12" r=".6" /><circle cx="10" cy="12" r=".6" />
            break;
        case "arrow-right":
            <path d="M2.5 8h11M9.5 4l4 4-4 4" />
            break;
        case "to-top":
            <path d="M3.5 2.5h9M8 13.5V5.5M4.5 9L8 5.5 11.5 9" />
            break;
        case "to-bottom":
            <path d="M3.5 13.5h9M8 2.5v8M4.5 7L8 10.5 11.5 7" />
            break;
        case "workflow":
            <circle cx="4" cy="4" r="1.8" /><circle cx="12" cy="12" r="1.8" /><path d="M5.8 4H10a2 2 0 0 1 2 2v4.2" />
            break;
        case "chevron-left":
            <path d="M10 4L6 8l4 4" />
            break;
        case "trash":
            <path d="M3 4.5h10M6.5 4.5V3h3v1.5M4.5 4.5l.6 9h5.8l.6-9" />
            break;
        case "comment":
            <path d="M2.5 3.5h11v7h-6l-3 2.5v-2.5h-2z" />
            break;
        case "link":
            <path d="M6.8 9.2a2.5 2.5 0 003.5 0l2.2-2.2a2.5 2.5 0 00-3.5-3.5l-.8.8M9.2 6.8a2.5 2.5 0 00-3.5 0L3.5 9a2.5 2.5 0 003.5 3.5l.8-.8" />
            break;
        case "check":
            <path d="M3 8.5l3.2 3L13 4.5" />
            break;
        case "bold":
            <path d="M4.5 3h4.2a2.4 2.4 0 010 4.8H4.5zM4.5 7.8h4.9a2.6 2.6 0 010 5.2H4.5z" stroke-width="1.8" />
            break;
        case "italic":
            <path d="M7 3h5M4 13h5M9.5 3l-3 10" />
            break;
        case "strike":
            <path d="M2.5 8h11M11 4.5C10.4 3.3 9.3 2.8 8 2.8c-1.8 0-3 1-3 2.3 0 .9.6 1.6 1.6 2M5 11.3c.6 1.2 1.7 1.9 3.1 1.9 1.9 0 3.1-1 3.1-2.4 0-.6-.2-1.1-.6-1.5" />
            break;
        case "code":
            <path d="M5.5 4.5L2 8l3.5 3.5M10.5 4.5L14 8l-3.5 3.5" />
            break;
        case "heading":
            <path d="M3 3v10M10 3v10M3 8h7M12.5 9.5l1.5-1v4.5" />
            break;
        case "list-bullet":
            <circle cx="3" cy="4.5" r=".9" fill="currentColor" /><circle cx="3" cy="8" r=".9" fill="currentColor" /><circle cx="3" cy="11.5" r=".9" fill="currentColor" /><path d="M6 4.5h8M6 8h8M6 11.5h8" />
            break;
        case "list-number":
            <path d="M6 4.5h8M6 8h8M6 11.5h8M2.3 3.3l1-.5v3M2.2 9.5c.4-.6 1.8-.6 1.8.3 0 .7-1.9 1.3-1.9 2.2h2" stroke-width="1.1" />
            break;
        case "quote":
            <path d="M3 4h4v4c0 2-1 3.5-3 4M9.5 4h4v4c0 2-1 3.5-3 4" />
            break;
        case "code-block":
            <rect x="2" y="2.5" width="12" height="11" rx="1.5" /><path d="M6 6.5L4.5 8 6 9.5M10 6.5L11.5 8 10 9.5" />
            break;
        case "table":
            <rect x="2" y="2.5" width="12" height="11" rx="1.5" /><path d="M2 6.5h12M2 10h12M6.5 6.5v7M10 6.5v7" />
            break;
        case "close":
            <path d="M4 4l8 8M12 4l-8 8" />
            break;
        case "empty":
            <rect x="2.5" y="4.5" width="9" height="8" rx="1.5" /><path d="M4.5 4.5V3.5a1 1 0 011-1h7a1 1 0 011 1v7a1 1 0 01-1 1h-1" /><path d="M5 8.5l1.5 1.5 3-3" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter]
    public int Size { get; set; } = 16;

    [Parameter]
    public string? Class { get; set; }
}
