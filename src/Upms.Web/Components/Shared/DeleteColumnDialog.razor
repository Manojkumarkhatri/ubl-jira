@using Upms.Application.Projects
@using Upms.Domain.Common
@* Deleting a board column, from the space settings or the board (Phase 1 FR-038, FR-039; Jira parity pass FR-011): the
   column's work items move to a column the person chooses; the only "to do" or "done" column cannot go. *@
<ModalDialog @ref="_dialog" Title="@($"Delete {_deleting?.Name}?")" TestId="delete-column">
    <ChildContent>
        @if (_deleting is { } deleting)
        {
            @if (_blocked is not null)
            {
                <p role="alert" data-testid="delete-blocked">@_blocked</p>
            }
            else if (deleting.IsEmpty)
            {
                <p>@deleting.Name holds no work items.</p>
            }
            else
            {
                <div class="field">
                    <label for="delete-destination">
                        Move its work items@(deleting.ItemCount > 0 ? $" ({deleting.ItemCount})" : "") to
                    </label>
                    <select id="delete-destination" class="select" @bind="_destinationId"
                            aria-invalid="@(_error is null ? "false" : "true")" aria-describedby="delete-destination-hint delete-destination-error">
                        <option value="">Choose a column</option>
                        @foreach (var other in Columns.Where(c => c.Id != deleting.Id))
                        {
                            <option value="@other.Id">@other.Name</option>
                        }
                    </select>
                    <span id="delete-destination-hint" class="hint">Sub-tasks and deleted tasks in the column move too; each move is recorded in the task's history.</span>
                </div>
            }
            <span id="delete-destination-error" class="error-text" role="alert">@_error</span>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn" @onclick="() => _dialog.CloseAsync()">@(_blocked is null ? "Cancel" : "Close")</button>
        @if (_blocked is null)
        {
            <button type="button" class="btn btn-danger" disabled="@_busy" @onclick="DeleteAsync">Delete column</button>
        }
    </Footer>
</ModalDialog>

@code {
    private ModalDialog _dialog = default!;
    private BoardColumnView? _deleting;
    private string? _destinationId;
    private string? _error;
    private string? _blocked;
    private bool _busy;

    /// <summary>The board's columns as they are now.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<BoardColumnView> Columns { get; set; } = [];

    /// <summary>Deletes the column, moving its items to the destination; answers the refusal, or null when it is done
    /// (or when the columns changed meanwhile, which the owner shows).</summary>
    [Parameter, EditorRequired]
    public Func<BoardColumnView, long?, Task<AppError?>> OnDelete { get; set; } = default!;

    public void Open(BoardColumnView column)
    {
        _deleting = column;
        _destinationId = null;
        _error = null;
        // Say straight away when the column cannot go (FR-038); the server enforces the same rule.
        var lastOfKind = column.Category != StatusCategory.InProgress && Columns.Count(c => c.Category == column.Category) == 1;
        _blocked = lastOfKind
            ? $"{column.Name} is the board's only \"{CategoryName(column.Category).ToLowerInvariant()}\" column, and every board needs one. " +
              "Add another column of that type first."
            : null;
        _dialog.Open();
    }

    public static string CategoryName(StatusCategory category) => category switch
    {
        StatusCategory.ToDo => "To do",
        StatusCategory.InProgress => "In progress",
        _ => "Done",
    };

    private async Task DeleteAsync()
    {
        if (_deleting is not { } column || _busy)
        {
            return;
        }

        long? destination = long.TryParse(_destinationId, System.Globalization.CultureInfo.InvariantCulture, out var id) ? id : null;
        if (!column.IsEmpty && destination is null)
        {
            _error = "Choose the column its work items should move to.";
            return;
        }

        _busy = true;
        try
        {
            var error = await OnDelete(column, destination);
            if (error is null)
            {
                await _dialog.CloseAsync();
                _deleting = null;
            }
            else
            {
                _error = error.MessageFor("DestinationColumnId");
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
