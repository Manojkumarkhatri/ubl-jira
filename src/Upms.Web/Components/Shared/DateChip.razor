@using System.Globalization
@* A date as a small field in Jira's Create form: its name, then a visible date box that can be typed into or picked from
   the calendar, then a way to clear it. The clear button keeps its place when there is no date, so nothing beside the field
   moves while a person works (live test, 2026-10-28). *@
<span class="chip-date @(Value is null ? "" : "has-value")">
    <label class="chip-date-label" for="@Id"><Icon Name="calendar" /> @Label</label>
    <input id="@Id" class="chip-date-input" type="date" min="2000-01-01" max="2099-12-31"
           value="@(Value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "")" @onchange="ChangedAsync" />
    <button type="button" class="chip-clear @(Value is null ? "is-empty" : "")" aria-label="Clear @Label" disabled="@(Value is null)"
            @onclick="() => ValueChanged.InvokeAsync(null)"><Icon Name="close" Size="12" /></button>
</span>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = "";

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public DateOnly? Value { get; set; }

    [Parameter]
    public EventCallback<DateOnly?> ValueChanged { get; set; }

    private Task ChangedAsync(ChangeEventArgs e) =>
        ValueChanged.InvokeAsync(DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
            ? date
            : null);
}
