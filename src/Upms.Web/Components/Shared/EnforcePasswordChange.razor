@inject NavigationManager Navigation

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    // Guards interactive navigation; MustChangePasswordMiddleware guards full page loads (FR-003).
    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationState is not null
            && (await AuthenticationState).User.HasClaim(UpmsClaimTypes.MustChangePassword, "true"))
        {
            Navigation.NavigateTo("Account/ChangePassword", forceLoad: true);
        }
    }
}
