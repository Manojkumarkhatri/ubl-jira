@using Upms.Application.Work
@using Upms.Domain.Work
@inject ISearchService Search
@inject NavigationManager Navigation
@* The search box on every screen (Phase 4 FR-032, FR-033; research R16, R25), a combobox: focused while empty it lists the
   items opened last; while typing it lists the first matching items and "Search for …", as Jira does (live test,
   2026-10-28); a key and Enter opens that item; words and Enter open the search page. *@
<div class="search-box" role="search">
    <input id="global-search" class="input search-input" type="text" role="combobox" autocomplete="off" spellcheck="false"
           aria-label="Search or type a key" placeholder="Search or type a key" aria-autocomplete="list"
           aria-expanded="@(Open ? "true" : "false")" aria-controls="global-search-list" aria-activedescendant="@ActiveId"
           aria-describedby="global-search-message" @bind="_text" @bind:event="oninput" @bind:after="TypedAsync" @onfocus="FocusedAsync" @onblur="Blurred"
           @onkeydown="KeyDownAsync" />
    @if (Open)
    {
        <ul id="global-search-list" class="search-recent" role="listbox" aria-label="@(Typing ? "Matching work items" : "Recently viewed")">
            @for (var i = 0; i < Items.Count; i++)
            {
                var index = i;
                var item = Items[i];
                <li id="@OptionId(index)" role="option" aria-selected="@(index == _active ? "true" : "false")"
                    class="@(index == _active ? "is-active" : "")" @onmousedown="() => Go(item)" @onmousedown:preventDefault="true">
                    <TypeIcon Type="item.Type" /> <span class="key">@item.Key</span> <span class="recent-title">@item.Title</span>
                    <span class="hint">@item.ProjectName</span>
                </li>
            }
            @if (Typing)
            {
                <li id="@OptionId(Items.Count)" role="option" aria-selected="@(_active == Items.Count ? "true" : "false")"
                    class="search-all @(_active == Items.Count ? "is-active" : "")" @onmousedown="SubmitAsync" @onmousedown:preventDefault="true">
                    <Icon Name="search" Size="14" /> Search for "@_text.Trim()"
                </li>
            }
        </ul>
    }
    <span id="global-search-message" class="search-message" role="status">@_message</span>
</div>

@code {
    private const int MatchesShown = 6;

    private IReadOnlyList<SearchResultRow> _recent = [];
    private IReadOnlyList<SearchResultRow> _matches = [];
    private string _text = "";
    private string? _message;
    private int _active = -1;
    private bool _showRecent;
    private bool _showMatches;
    private int _request;

    /// <summary>Two letters or more: the list shows matches instead of the recent items.</summary>
    private bool Typing => _showMatches && _text.Trim().Length >= 2;

    private IReadOnlyList<SearchResultRow> Items => Typing ? _matches : _recent;

    private bool Open => Typing || (_showRecent && _text.Length == 0 && _recent.Count > 0);

    /// <summary>The options: the items, and while typing "Search for …" after them.</summary>
    private int OptionCount => Items.Count + (Typing ? 1 : 0);

    private string? ActiveId => Open && _active >= 0 ? OptionId(_active) : null;

    private static string OptionId(int index) => $"global-search-option-{index}";

    private async Task FocusedAsync()
    {
        if (_text.Length == 0)
        {
            var recent = await Search.RecentAsync(CancellationToken.None);
            _recent = recent.IsSuccess ? recent.Value! : [];
            _showRecent = true;
            _active = -1;
        }
        else
        {
            _showMatches = true;
        }
    }

    private void Blurred()
    {
        _showRecent = false;
        _showMatches = false;
    }

    // @bind keeps characters typed while the server is busy; value= with @oninput would put back an older value.
    private async Task TypedAsync()
    {
        _message = null;
        _active = -1;
        _showRecent = _text.Length == 0;
        var text = _text.Trim();
        var request = ++_request;
        if (text.Length < 2)
        {
            _matches = [];
            return;
        }

        // A short pause, so a quick typist does not search every letter; an answer for older text is dropped.
        await Task.Delay(200);
        if (request != _request)
        {
            return;
        }

        var found = await Search.SearchAsync(new SearchQuery(text), new PageRequest(1, MatchesShown), CancellationToken.None);
        if (request != _request || _text.Trim() != text)
        {
            return;
        }

        _matches = found.IsSuccess ? found.Value!.Rows.Items : [];
        _showMatches = true;
    }

    private async Task KeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown" or "ArrowUp" when Open:
                _active = e.Key == "ArrowDown" ? (_active + 1) % OptionCount : (_active <= 0 ? OptionCount : _active) - 1;
                break;
            case "ArrowDown" when _text.Length == 0:
                await FocusedAsync();
                break;
            case "Escape":
                _showRecent = false;
                _showMatches = false;
                _message = null;
                break;
            case "Enter" when Open && _active >= 0 && _active < Items.Count:
                Go(Items[_active]);
                break;
            case "Enter":
                await SubmitAsync();
                break;
        }
    }

    /// <summary>A key opens its item, or says it was not found; anything else searches (FR-032).</summary>
    private async Task SubmitAsync()
    {
        var text = _text.Trim();
        if (text.Length == 0)
        {
            return;
        }

        if (SearchWords.LooksLikeKey(text, out _))
        {
            var found = await Search.ResolveKeyAsync(text, CancellationToken.None);
            if (!found.IsSuccess)
            {
                _message = found.Error!.Message;
                return;
            }

            var key = found.Value!;
            Reset();
            Navigation.NavigateTo($"spaces/{key[..key.LastIndexOf('-')]}/board?task={Uri.EscapeDataString(key)}");
            return;
        }

        Reset();
        Navigation.NavigateTo($"search?q={Uri.EscapeDataString(text)}");
    }

    private void Go(SearchResultRow item)
    {
        Reset();
        Navigation.NavigateTo($"spaces/{item.ProjectKey}/board?task={Uri.EscapeDataString(item.Key)}");
    }

    private void Reset()
    {
        _request++;
        _text = "";
        _message = null;
        _showRecent = false;
        _showMatches = false;
        _matches = [];
        _active = -1;
    }
}
