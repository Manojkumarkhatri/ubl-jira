@using Upms.Application.Notifications
@implements IDisposable
@inject INotificationService Notifications
@inject TimeProvider Time
@* The bell on every screen (Phase 4 FR-018, research R9, R25): its name carries the unread count, which refreshes every
   30 seconds and whenever the panel opens or closes. *@
<div class="bell-wrap">
    <button type="button" class="btn btn-ghost bell" data-testid="bell" @ref="_button" aria-label="@($"Notifications, {_unread} unread")"
            aria-expanded="@(_open ? "true" : "false")" aria-controls="notification-panel" @onclick="ToggleAsync">
        <svg class="bell-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6V11a7 7 0 0 0-5.5-6.84V3.5a1.5 1.5 0 0 0-3 0v.66A7 7 0 0 0 5 11v5l-2 2v1h18v-1Z" fill="currentColor" />
        </svg>
        @if (_unread > 0)
        {
            <span class="bell-count" aria-hidden="true">@(_unread > 99 ? "99+" : _unread.ToString(System.Globalization.CultureInfo.CurrentCulture))</span>
        }
    </button>
    @if (_open)
    {
        <NotificationPanel OnClose="CloseAsync" OnChanged="RefreshAsync" />
    }
</div>

@code {
    public static readonly TimeSpan RefreshEvery = TimeSpan.FromSeconds(30);

    private readonly CancellationTokenSource _stop = new();
    private ElementReference _button;
    private int _unread;
    private bool _open;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        // Only once interactive: prerendering has no circuit to refresh.
        if (firstRender)
        {
            _ = RefreshEveryAsync(_stop.Token);
        }
    }

    private async Task RefreshEveryAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(RefreshEvery, Time);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // The page or circuit ended.
        }
    }

    private async Task RefreshAsync() => _unread = await Notifications.CountUnreadAsync(_stop.Token);

    private async Task ToggleAsync()
    {
        if (_open)
        {
            await CloseAsync();
            return;
        }

        _open = true;
        await RefreshAsync();
    }

    private async Task CloseAsync()
    {
        _open = false;
        await RefreshAsync();
        await _button.FocusAsync();
    }

    public void Dispose()
    {
        _stop.Cancel();
        _stop.Dispose();
    }
}
